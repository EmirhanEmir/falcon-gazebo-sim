+  // 409226a637):
+  //   * SIM_JSON.h:139/167  keytable entry {"", "airspeed", ..., DATA_FLOAT}
+  //     and DataKey::AIRSPEED (1ULL<<19) are part of the OFFICIAL JSON FDM
+  //     protocol - no protocol extension is invented here.
+  //   * SIM_JSON.cpp:437-453 - if the AIRSPEED bit is NOT set, SITL executes
+  //     `wind_ef.zero()` UNCONDITIONALLY and derives airspeed from
+  //     ground velocity via Aircraft::update_eas_airspeed()
+  //     (SIM_Aircraft.cpp:1409-1411). Emitting the airspeed key is therefore
+  //     the only way to get a wind-relative airspeed into ArduPilot over this
+  //     transport.
+  //   * UNITS/SEMANTICS: SITL treats the value as EQUIVALENT airspeed (EAS).
+  //     SIM_Aircraft.cpp:1411 `airspeed = velocity_air_ef.length()/eas2tas`
+  //     and SITL_State.cpp:112 -> sitl_airspeed.cpp:30
+  //     `_update_airspeed(float eas)`. The publisher on <airspeed_topic> is
+  //     responsible for supplying EAS in m/s.
+  //   * SIM_JSON.h:136/165 {"", "velocity_wind", ..., DATA_VECTOR3F} /
+  //     DataKey::WIND_VEL (1ULL<<16); SIM_JSON.cpp:456-458 sets
+  //     `wind_ef = state.velocity_wind` (earth-frame NED airmass VELOCITY,
+  //     per SIM_Aircraft.cpp:899-924 where velocity_air_ef = velocity_ef -
+  //     wind_ef). Supplied so that SITL's own wind truth is no longer a
+  //     silent zero.
+  // ---------------------------------------------------------------------
+
+  /// \brief Gazebo topic carrying scalar EQUIVALENT airspeed in m/s
+  /// (gz.msgs.Double). Empty => feature disabled (upstream behaviour).
+  public: std::string airspeedTopic;
+
+  /// \brief Mutex guarding airspeedMps / airspeedValid.
+  public: std::mutex airspeedMsgMutex;
+
+  /// \brief True once at least one airspeed message has been received.
+  public: bool airspeedValid{false};
+
+  /// \brief Most recently received scalar equivalent airspeed [m/s].
+  public: double airspeedMps{0.0};
+
+  /// \brief Callback for the scalar airspeed topic.
+  public: void AirspeedCb(const gz::msgs::Double &_msg)
+  {
+    if (!std::isfinite(_msg.data()))
+    {
+      // Reject non-finite values outright rather than poisoning the FDM
+      // packet (hold-last-valid failsafe, same convention as the FALCON V2
+      // wind plugin).
+      return;
+    }
+    std::lock_guard<std::mutex> lock(this->airspeedMsgMutex);
+    this->airspeedMps = _msg.data();
+    this->airspeedValid = true;
+  }
+
+  /// \brief Gazebo topic carrying the world-frame (Gazebo world frame, as
+  /// configured by <gazeboXYZToNED>) VELOCITY OF THE AIR MASS in m/s
+  /// (gz.msgs.Vector3d). Empty => feature disabled (upstream behaviour).
+  public: std::string windTopic;
+
+  /// \brief Mutex guarding windVelWldG / windValid.
+  public: std::mutex windMsgMutex;
+
+  /// \brief True once at least one wind message has been received.
+  public: bool windValid{false};
+
+  /// \brief Most recently received airmass velocity, Gazebo world frame.
+  public: gz::math::Vector3d windVelWldG{0.0, 0.0, 0.0};
+
+  /// \brief Callback for the world-frame wind velocity topic.
+  public: void WindCb(const gz::msgs::Vector3d &_msg)
+  {
+    if (!std::isfinite(_msg.x()) ||
+        !std::isfinite(_msg.y()) ||
+        !std::isfinite(_msg.z()))
+    {
+      return;
+    }
+    std::lock_guard<std::mutex> lock(this->windMsgMutex);
+    this->windVelWldG.Set(_msg.x(), _msg.y(), _msg.z());
+    this->windValid = true;
+  }
