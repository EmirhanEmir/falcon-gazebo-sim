<?xml version="1.0"?>
<!--
  FALCON V2 runway world - ground start for ArduPlane SITL takeoff.

  Ground plane, gravity, DART timestep, spherical datum, magnetic field and
  the gz-sim sensor-system chain, plus collision-free visual runway
  markings.

  ASSUMPTION (visualisation only): the runway centreline is world Y=0 and
  the runway direction is world +X. The visible strip is 400 m x 20 m.
  These dimensions are not aircraft physics and are not a real-site survey.

  Spawn pose is (-150, 0, 0.5, 0, 0, 0): aircraft body +X (nose-forward in
  the project's FLU convention) points along runway +X. Z = 0.5 m starts
  every collision primitive above the z=0 ground plane; with no landing
  gear, gravity then settles the aircraft onto its belly and wing collision
  primitives.

  This world adds or changes no aerodynamic, propulsion, actuator, sensor or
  ArduPilot parameter.
-->
<sdf version="1.9">
  <world name="falcon_v2_manual_takeoff_runway">
    <physics name="1ms" type="dartsim">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <!-- Lower ambient illumination so the directional-light shadows and the
         aircraft's contrast remain visible. Rendering only; no physics or
         sensor parameter is changed. -->
    <scene>
      <ambient>0.25 0.25 0.25 1</ambient>
      <background>0.62 0.70 0.80 1</background>
      <shadows>true</shadows>
    </scene>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>0.0</latitude_deg>
      <longitude_deg>0.0</longitude_deg>
      <elevation>0.0</elevation>
      <heading_deg>0.0</heading_deg>
    </spherical_coordinates>

    <magnetic_field>5.5645e-6 22.8758e-6 -42.3884e-6</magnetic_field>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Unmodified contact model from the grounded source world. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.18 0.28 0.14 1</ambient>
            <diffuse>0.18 0.28 0.14 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Visual-only runway.  There is deliberately no <collision>. -->
    <model name="runway_visual_only">
      <static>true</static>
      <link name="runway">
        <visual name="asphalt">
          <pose>0 0 0.001 0 0 0</pose>
          <geometry><box><size>400 20 0.002</size></box></geometry>
          <material>
            <ambient>0.12 0.12 0.12 1</ambient>
            <diffuse>0.16 0.16 0.16 1</diffuse>
          </material>
        </visual>
        <visual name="centerline">
          <pose>0 0 0.003 0 0 0</pose>
          <geometry><box><size>360 0.18 0.002</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
        <visual name="left_edge">
          <pose>0 9.7 0.003 0 0 0</pose>
          <geometry><box><size>398 0.18 0.002</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
        <visual name="right_edge">
          <pose>0 -9.7 0.003 0 0 0</pose>
          <geometry><box><size>398 0.18 0.002</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model</uri>
      <name>falcon_v2</name>
      <pose>-150 0 0.5 0 0 0</pose>
    </include>
  </world>
</sdf>
