<?xml version="1.0"?>
<!--
  FALCON V2 - ArduPlane SITL AHRS DCM/EKF3 consistency root-cause probe
  world (gazebo-testing, ARDUPLANE_SITL_TRANSPORT_AND_ACTUATOR_MAPPING_
  VALIDATION follow-up, 2026-08-28).

  Purpose: an independent diagnostic world (NOT a modification of
  falcon_v2_ardupilot_sitl_test_world.sdf, which stays exactly as this
  task's earlier pass left it) that spawns falcon_v2 resting under GENUINE
  ground-contact physics (real collision, real contact/normal reaction
  force from dartsim) instead of 50m AGL free-fall/tumble, and WITHOUT any
  gz-sim-systems::VelocityControl Cmd override.

  Rationale, evidence from this task's own live probing: a
  VelocityControl-based "hold the airframe stationary at zero body
  velocity" technique (used earlier this task, and by the earlier
  independent frame-validation work) forces the rigid body's velocity to
  IDENTICALLY zero every physics step via a kinematic override - this
  removes the body's own dynamic integration of gravity, so DART computes
  ~zero net acceleration for the body (since velocity never changes step to
  step by construction) - meaning gz-sensors' IMU accelerometer, which
  derives specific force from the body's actual physics-engine
  acceleration, reports ~0 m/s^2 (confirmed live this task: RAW_IMU
  xacc=yacc=zacc=0 for 10+ continuous seconds while "held"). A true
  free-falling body (no ground contact, negligible net aero force) shows
  the same near-zero specific-force reading for the same underlying
  physical reason (an accelerometer never senses gravity itself, only
  non-gravitational reaction/contact/aerodynamic forces) - so NEITHER of
  the two spawn conditions already used this task (VelocityControl-held,
  or 50m AGL free-fall) ever gives ArduPilot's AHRS_DCM backend a valid,
  non-zero gravity reference vector to run its accelerometer-based
  drift_correction() against (AP_AHRS_DCM.cpp ~line 792 onward,
  source-confirmed: when normalize()'d accel sum GA_b is exactly zero,
  drift_correction() explicitly skips that estimator - "wait for some
  non-zero acceleration information" - so DCM free-integrates gyro only,
  with zero P/I correction, for as long as this holds. This is the leading
  suspect for the persistent "AHRS: DCM Roll/Pitch inconsistent" prearm
  failure, DISTINCT from and not resolved by controls-integration's
  IMU gyro/accel FLU->FRD frame fix.

  This world spawns falcon_v2 belly-down at a small height (0.5 m) above
  the SAME ground_plane geometry falcon_v2_ardupilot_sitl_test_world.sdf
  already uses, so it settles onto real dartsim contact/collision within a
  couple of physics seconds under a genuine, non-kinematic-override contact
  normal force - giving the accelerometer a real ~1g reference to test the
  hypothesis above. No VelocityControl plugin is attached here at all
  (deliberately, to isolate this variable).

  Zero aircraft-physics parameter, zero model/model.sdf content, is
  modified by this file.
-->
<sdf version="1.9">
  <world name="falcon_v2_ardupilot_sitl_grounded_test">
    <physics name="1ms" type="dartsim">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>0.0</latitude_deg>
      <longitude_deg>0.0</longitude_deg>
      <elevation>0.0</elevation>
      <heading_deg>0.0</heading_deg>
    </spherical_coordinates>

    <magnetic_field>5.5645e-6 22.8758e-6 -42.3884e-6</magnetic_field>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>

    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"></plugin>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"></plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Spawned 0.5 m above the ground plane, level, so base_link's own
         fuselage_collision_fwd/mid/tail boxes (Z=[0,0.330480] in base_link
         frame, model.sdf, unmodified/cited not re-derived) settle onto
         real ground contact within a couple of physics seconds - giving
         gz-sensors' IMU a genuine, non-kinematic-override gravity
         reference. -->
    <include>
      <uri>file:///home/emirhan/Desktop/FalconV2/model</uri>
      <name>falcon_v2</name>
      <pose>0 0 0.5 0 0 0</pose>
    </include>
  </world>
</sdf>
