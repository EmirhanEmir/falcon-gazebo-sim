<?xml version="1.0"?>
<!--
  FALCON V2 — Gazebo Sim Harmonic model package descriptor.

  No metadata below is invented: name/description are restated directly from
  CLAUDE.md and docs/source_of_truth/. No author name/email is asserted
  anywhere in this repository, so <author> is intentionally omitted rather
  than filled with a placeholder.
-->
<model>
  <name>Falcon V2</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <description>
    FALCON V2 — Titan Dynamics conventional-tail fixed-wing UAV. Structural
    V1 skeleton (links, joints, mass/CG/inertia, visual and collision
    geometry) plus a V1 aerodynamic force/moment System plugin
    (FalconV2Aerodynamics, plugins/aerodynamics/ — updated 2026-08-22, task
    AERODYNAMICS_V1_IMPLEMENTATION). No propulsion-force or
    control-actuation model is implemented in this package yet — see
    model.sdf header comment and docs/source_of_truth/ for full provenance
    and open items.
  </description>
</model>
