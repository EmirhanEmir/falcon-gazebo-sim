    "TH_OSC_PEAK_PROMINENCE_FRAC": {
      "value": 0.05,
      "provenance": "ASSUMPTION - a half-cycle peak below 5 % of the detrended peak-to-peak is treated as noise and not counted as an oscillation peak.",
