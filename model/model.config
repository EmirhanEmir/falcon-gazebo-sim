<?xml version="1.0"?>
<model>
  <name>Falcon V2</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <description>
    FALCON V2 — Titan Dynamics konvansiyonel kuyruklu, çift motorlu sabit
    kanat İHA'sı. Tam 6 serbestlik dereceli Gazebo Sim Harmonic modeli:
    8 link, 7 joint, kütle/CG/atalet, görsel ve collision geometrisi; ayrıca
    aerodinamik, itki, aktüatör, rüzgâr ve sensör sistem eklentileri ile
    ArduPlane SITL taşıma köprüsü. Gövde çerçevesi FLU (+X ileri, +Y sol,
    +Z yukarı), toplam kütle 6.000 kg.
  </description>
</model>
