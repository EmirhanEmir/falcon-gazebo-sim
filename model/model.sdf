    <!-- ============================================================
         AERODYNAMICS PLUGIN
         Author (this addition): aerodynamics specialist agent, 2026-08-22,
         task AERODYNAMICS_V1_IMPLEMENTATION. This is an ADDITIVE change
         only: no link, joint, mass, CG, inertia, collision, visual, or
         hinge-geometry element above was modified to add this block
         (geometry-structure's structural content, lines 1-1042, is
         unchanged). Scope: aerodynamic force/moment physics only - no
         propulsion, no control-actuation (this plugin READS the 5
         control-surface joint positions defined above, it does not
         command/write them).

         Build: plugins/aerodynamics/ (see plugins/aerodynamics/README.md).
         Full architecture/provenance/derivation record:
         docs/source_of_truth/aerodynamics/AERODYNAMICS.md (this pass) and
         docs/source_of_truth/aerodynamics/aero_v1_config.yaml (the
         structured coefficient dataset this plugin loads at Configure()
         time - no coefficient is hardcoded in this SDF block or in the
         plugin's C++ source).

         config_path is an absolute path, matching this repository's
         existing convention for single-machine-dev test infrastructure
         (e.g. tests/gazebo/worlds/*.sdf's file:// includes and
         tests/gazebo/scripts/*.py's WORLD_SDF constants) - not resolved
         relative to the model directory by SDF itself; a documented,
         known V1 portability limitation, not a silent one.
         ============================================================ -->
    <plugin filename="FalconV2Aerodynamics" name="falcon_v2_aero::AerodynamicsSystem">
      <config_path>/home/emirhan/Desktop/FalconV2/docs/source_of_truth/aerodynamics/aero_v1_config.yaml</config_path>
      <!-- Optional override of the YAML air_density value (kg/m^3). ISA
           sea-level default 1.225, CONFIRMED provenance - see
           aero_v1_config.yaml "environment" block. -->
      <air_density>1.225</air_density>
      <!-- gz.msgs.Vector3d topic, WORLD frame, m/s. V1: Vwind=0 (no
           publisher exists yet) - this is the "architecture must support
           future wind input" hook (CLAUDE.md), not an implemented wind
           model. -->
      <wind_topic>/model/falcon_v2/wind</wind_topic>
      <!-- Throttled gz.msgs.Double_V diagnostics publish rate (Hz) on
           /model/falcon_v2/aerodynamics/diagnostics. Field order:
           V, alpha_rad, beta_rad, qbar, CL, CD, CY, Cl, Cm, Cn. -->
      <diagnostics_rate_hz>20.0</diagnostics_rate_hz>
    </plugin>

    <!-- ============================================================
         PROPULSION PLUGIN
         Author (this addition): propulsion specialist agent, 2026-08-23,
         task PROPULSION_V1_IMPLEMENTATION. This is an ADDITIVE change only:
         no link, joint, mass, CG, inertia, collision, visual, or
         hinge-geometry element above was modified to add this block
         (geometry-structure's structural content is unchanged, including
         left_prop/right_prop's mass/placeholder inertia and
         left_prop_joint/right_prop_joint's axis/limits - this plugin drives
         those existing joints' angular VELOCITY each tick, it does not
         redefine them). Scope: motor/ESC/propeller physics only - no
         aerodynamic-coefficient physics (plugins/aerodynamics/ untouched),
         no control-surface actuation, no ArduPilot/SITL.

         Required chain implemented (never bypassed, never collapsed into
         throttle*maximum_thrust - see CLAUDE.md/PROPULSION.md): throttle ->
         ESC/motor electrical -> motor torque -> rotor angular dynamics
         (explicit-Euler state, plugin-owned, integrated every tick) -> RPM
         -> advance ratio J -> real APC Ct(J,RPM)/Cp(J,RPM) -> thrust +
         propeller aerodynamic torque -> reaction torque -> force/moment
         applied to base_link at the real hub (left_hub/right_hub, never at
         CG). The same omega state also drives left_prop_joint/
         right_prop_joint's angular velocity, so the visual spin can never
         diverge from the physics RPM actually producing forces/torques.

         Build: plugins/propulsion/ (see plugins/propulsion/README.md). Full
         architecture/provenance record:
         docs/source_of_truth/propulsion/PROPULSION.md and
         docs/source_of_truth/propulsion/propulsion_v1_config.yaml (the
         structured dataset this plugin loads at Configure() time - no
         coefficient is hardcoded in this SDF block or in the plugin's C++
         source). Real APC 13x6.5E Ct(J)/Cp(J) data:
         docs/source_of_truth/propulsion/data/apc_13x65e_parsed.csv
         (mechanically parsed from the official APC performance-data file
         PER3_13x65E.dat - see data/PROVENANCE.md).

         V1 throttle test interface (no ArduPilot/SITL exists yet): each
         motor is commanded independently via a gz.msgs.Double topic,
         clamped to [0,1], defaulting to 0 if never commanded.

         config_path is an absolute path, matching this repository's
         existing convention (see the aerodynamics plugin block above) - a
         documented, known V1 portability limitation, not a silent one.
         ============================================================ -->
    <plugin filename="FalconV2Propulsion" name="falcon_v2_propulsion::PropulsionSystem">
      <config_path>/home/emirhan/Desktop/FalconV2/docs/source_of_truth/propulsion/propulsion_v1_config.yaml</config_path>
      <!-- Optional override of the YAML rho_kg_m3 value (kg/m^3). ISA
           sea-level default 1.225, CONFIRMED provenance - see
           propulsion_v1_config.yaml "physics" block. -->
      <air_density>1.225</air_density>
      <!-- gz.msgs.Vector3d topic, WORLD frame, m/s - same topic the
           aerodynamics plugin subscribes to (read-only here), used for
           relative-airflow V_axial at each motor's hub. Zero until a
           publisher exists. -->
      <wind_topic>/model/falcon_v2/wind</wind_topic>
      <!-- Per-motor throttle command topics, gz.msgs.Double, value clamped
           to [0,1] by the plugin, default 0 if never published. -->
      <left_throttle_topic>/model/falcon_v2/propulsion/left/throttle_cmd</left_throttle_topic>
      <right_throttle_topic>/model/falcon_v2/propulsion/right/throttle_cmd</right_throttle_topic>
      <!-- Throttled gz.msgs.Double_V diagnostics publish rate (Hz) on
           /model/falcon_v2/propulsion/diagnostics. Field order (14 fields
           per motor, left then right): throttle, current_A, Q_motor_Nm,
           omega_ownframe_rad_s, rpm, J, Ct, Cp, thrust_N, Q_prop_Nm,
           interpClamped, rpmCapActive, negativeCurrentClamped,
           currentLimited. -->
      <diagnostics_rate_hz>20.0</diagnostics_rate_hz>
    </plugin>

    <!-- ============================================================
         ACTUATOR/SERVO PLUGIN
         Author (this addition): controls-integration specialist agent,
         2026-08-23, task ACTUATOR_SERVO_MODEL_V1. This is an ADDITIVE
         change only: no link, joint, mass, CG, inertia, collision, visual,
         or hinge-geometry element was modified to add this block beyond
         the 5 control-surface joints' own <limit> values (widened to
         +/-45 deg above, see the file-header "CONTROL-SURFACE JOINT LIMIT
         UPDATE" section) - this plugin drives those existing 5 joints'
         real physical motion, it does not redefine their link/geometry.
         Scope: the physical actuator/servo command chain only (actuator
         command -> rate-limited/effort-bounded servo dynamics -> real
         Gazebo joint motion via genuine gz::sim::Joint::SetForce() torque -
         replaces the previous test-script-only direct position injection
         as the actuation mechanism for these 5 joints). No aerodynamic-
         coefficient physics (plugins/aerodynamics/ untouched, no control-
         sign-mapping value changed), no motor/propulsion physics
         (plugins/propulsion/ untouched), no ArduPlane/MAVLink/SITL/TECS -
         this plugin ends at the physical actuator interface.
         plugins/aerodynamics/AerodynamicsSystem.cc continues to read these
         same 5 joints' ACTUAL positions from the ECM every tick exactly as
         before (gz::sim::Joint(e).Position(_ecm)), regardless of what now
         drives them - unmodified, confirmed by direct reading of that file
         for this task.

         Build: plugins/actuators/ (see plugins/actuators/README.md). Full
         architecture/provenance record:
         docs/source_of_truth/controls/actuator_v1_config.yaml (the
         structured per-surface travel/rate/effort/control-law dataset this
         plugin loads at Configure() time - no coefficient is hardcoded in
         this SDF block or in the plugin's C++ source) and
         docs/source_of_truth/controls/CONTROLS.md.

         V1 command interface (no ArduPilot/SITL exists yet): each of the 5
         surfaces is commanded independently via its own gz.msgs.Double
         topic (physical-angle-radians, hold-last-valid-command failsafe,
         defaulting to 0 rad/neutral if never commanded - no startup kick).

         config_path is an absolute path, matching this repository's
         existing convention (see the aerodynamics/propulsion plugin blocks
         above) - a documented, known V1 portability limitation, not a
         silent one.
         ============================================================ -->
    <plugin filename="FalconV2Actuators" name="falcon_v2_actuators::ActuatorSystem">
      <config_path>/home/emirhan/Desktop/FalconV2/docs/source_of_truth/controls/actuator_v1_config.yaml</config_path>
      <!-- Per-surface command topics, gz.msgs.Double, physical-angle-radians,
           clamped to +/-45 deg by the plugin, rate-limited internally,
           hold-last-valid-command failsafe, default 0 rad (neutral) if
           never published. Values below match this plugin's own built-in
           defaults - listed explicitly here for documentation/
           discoverability/override, same convention as the propulsion
           plugin block above's left_throttle_topic/right_throttle_topic. -->
      <left_aileron_cmd_topic>/model/falcon_v2/actuators/left_aileron/cmd_rad</left_aileron_cmd_topic>
      <right_aileron_cmd_topic>/model/falcon_v2/actuators/right_aileron/cmd_rad</right_aileron_cmd_topic>
      <left_elevator_cmd_topic>/model/falcon_v2/actuators/left_elevator/cmd_rad</left_elevator_cmd_topic>
      <right_elevator_cmd_topic>/model/falcon_v2/actuators/right_elevator/cmd_rad</right_elevator_cmd_topic>
      <rudder_cmd_topic>/model/falcon_v2/actuators/rudder/cmd_rad</rudder_cmd_topic>
      <!-- gz.msgs.Double_V diagnostics on
           /model/falcon_v2/actuators/diagnostics. Field order (7 fields per
           surface, left_aileron/right_aileron/left_elevator/
           right_elevator/rudder): cmd_rad, target_clamped_rad, setpoint_rad,
           actual_angle_rad, actual_rate_rad_s, target_clamp_active,
           effort_clamp_active - 35 fields total. -->
      <diagnostics_rate_hz>20.0</diagnostics_rate_hz>
    </plugin>

    <!-- ============================================================
         WIND/GUST GENERATOR PLUGIN
         Author (this addition): aerodynamics specialist agent, 2026-08-27,
         task WIND_GUST_DISTURBANCE_MODEL_AND_VALIDATION. This is an
         ADDITIVE change only: no link, joint, mass, CG, inertia, collision,
         visual, hinge-geometry, or other <plugin> element above was
         modified to add this block. Scope: publishes a world-frame wind
         VELOCITY vector only - it is the FIRST publisher for the
         PRE-EXISTING /model/falcon_v2/wind topic that
         plugins/aerodynamics/AerodynamicsSystem.cc and
         plugins/propulsion/PropulsionSystem.cc already subscribe to and
         already correctly consume as Vrel = Vbody - Vwind (CONFIRMED by
         direct read of both files for this task; NEITHER FILE WAS MODIFIED
         by this task). This plugin NEVER applies a direct force/wrench to
         any link (no AddWorldForce/AddWorldWrench anywhere in
         plugins/wind/) - its only physical output is the published
         velocity vector; all aerodynamic/propulsive effect of wind flows
         exclusively through the pre-existing relative-airflow consumption
         in the two files named above.

         Build: plugins/wind/ (see plugins/wind/README.md). Full
         convention/formula/scope record:
         docs/source_of_truth/environment/WIND.md.

         Convention: published vectors are the WORLD-FRAME VELOCITY OF THE
         AIR MASS (not meteorological "wind coming from" phrasing) - see
         WIND.md sec 2.

         V1 command interface: a live-updatable steady-wind vector
         (steady_cmd_topic) plus a single schedulable deterministic
         1-cosine gust (gust_cmd_topic, fixed 6-field order - see WIND.md
         sec 4/6). V1 LIMITATION (stated, not silent): only ONE gust may be
         scheduled/in-progress at a time - a new gust command replaces any
         existing one (WIND.md sec 5).
         ============================================================ -->
    <plugin filename="FalconV2Wind" name="falcon_v2_wind::WindSystem">
      <!-- Constant wind component at startup, world frame, m/s. Default
           zero vector: with this left at "0 0 0" and no gust ever
           commanded, the published wind is bit-identical to the prior
           always-zero behavior (WIND.md sec 8) - purely additive, no
           existing validated result can change unless this plugin is
           actively commanded. Live-overwritable via steady_cmd_topic
           below. -->
      <steady_wind_mps>0 0 0</steady_wind_mps>
      <!-- gz.msgs.Vector3d topic, WORLD frame, m/s - the SAME pre-existing
           topic plugins/aerodynamics/AerodynamicsSystem.cc and
           plugins/propulsion/PropulsionSystem.cc already subscribe to.
           Published every PreUpdate() tick (unthrottled), never as a
           direct force. -->
      <wind_topic>/model/falcon_v2/wind</wind_topic>
      <!-- Live steady-wind command, gz.msgs.Vector3d, world frame, m/s.
           Hold-last-valid-command failsafe; non-finite components
           rejected. -->
      <steady_cmd_topic>/model/falcon_v2/wind/steady_cmd</steady_cmd_topic>
      <!-- Single deterministic 1-cosine gust command, gz.msgs.Double_V,
           FIXED field order:
             [0] dir_x, [1] dir_y, [2] dir_z   - raw direction (need not be
                 pre-normalized; normalized internally; degenerate/near-
                 zero direction rejected)
             [3] amplitude_mps                 - peak gust speed, m/s (may
                 be negative, flips sense relative to dir_x/y/z)
             [4] start_delay_s                 - seconds from THIS
                 COMMAND'S RECEIPT (not absolute sim time) - see WIND.md
                 sec 7 for the exact reference-time mechanism/rationale
             [5] duration_s                    - seconds, must be > 0
           V1 LIMITATION: only one gust may be scheduled/in-progress at a
           time - a new valid command replaces any existing one outright
           (WIND.md sec 5). -->
      <gust_cmd_topic>/model/falcon_v2/wind/gust_cmd</gust_cmd_topic>
    </plugin>

    <!-- ============================================================
         PITOT (SIMULATED AIRSPEED) SENSOR PLUGIN
         Author (this addition): controls-integration specialist agent,
         2026-08-27, task SENSOR_MODEL_AND_ARDUPLANE_SITL_PREPARATION.

         OLD-vs-NEW status (per user-confirmed fact, see
         docs/source_of_truth/sensors/SENSORS.md sec 1 and
         docs/source_of_truth/autopilot/SITL_PARAM_MIGRATION.md): the REAL
         Falcon V2 airframe had NO pitot/airspeed sensor installed when
         docs/source_of_truth/autopilot/real_aircraft/yeni_pixhawk.param was
         captured (ARSPD_TYPE=0 there = None). This plugin is a NEW,
         SIMULATION-ONLY addition (status SIMULATION_ADDED_PITOT_SENSOR) -
         it does not represent any physical sensor that has flown on the
         real aircraft.

         WHY A CUSTOM PLUGIN, NOT THE NATIVE gz-sim air_speed <sensor>: see
         plugins/sensors/PitotModel.hh header comment and SENSORS.md sec 3
         for the full decision record (short version: the installed
         sdformat air_speed.sdf sensor spec has no wind-consuming field at
         all, and the only native Gazebo wind mechanism found on this
         system, gz-sim-wind-effects-system, is architecturally unrelated
         to this project's own /model/falcon_v2/wind topic - using it would
         silently fail the mandatory live headwind/tailwind gust test).

         Subscribes to the EXISTING /model/falcon_v2/wind topic (read-only,
         same convention as AerodynamicsSystem.cc/PropulsionSystem.cc) -
         creates NO new command path into aero/propulsion/actuators.
         air_density_rho_kg_m3 default below is CITED from
         docs/source_of_truth/aerodynamics/aero_v1_config.yaml
         environment.air_density_rho_kg_m3 (CONFIRMED, 1.225, ISA
         sea-level) - not re-derived or independently chosen here.
         ============================================================ -->
    <plugin filename="FalconV2Pitot" name="falcon_v2_sensors::PitotSystem">
      <!-- Mount point (m, FLU, relative to base_link origin) - co-located
           with the Gazebo/CAD CG per the same documented choice as the 4
           native sensors above (SIMULATION_ASSUMPTION, mount location
           DATA_REQUIRED for the real airframe). -->
      <mount_offset_body>0.168309 0 0.100000</mount_offset_body>
      <air_density_rho_kg_m3>1.225</air_density_rho_kg_m3>
      <!-- V1_PROVISIONAL update rate - see SENSORS.md sec 6. -->
      <update_rate_hz>10.0</update_rate_hz>
      <!-- V1_PROVISIONAL_SENSOR_NOISE - OFF by default (0.0 = deterministic
           mode, the default/validated mode). -->
      <noise_stddev_mps>0.0</noise_stddev_mps>
      <wind_topic>/model/falcon_v2/wind</wind_topic>
      <!-- gz.msgs.Double, m/s - scalar airspeed (frame-invariant
           magnitude of Vrel = Vpoint_world - Vwind_world). -->
      <airspeed_topic>/model/falcon_v2/sensors/pitot/airspeed_mps</airspeed_topic>
      <!-- gz.msgs.Double, Pa - standard incompressible dynamic pressure
           q = 0.5*rho*V^2 (see PitotModel.hh). -->
      <pressure_topic>/model/falcon_v2/sensors/pitot/differential_pressure_pa</pressure_topic>
    </plugin>

    <!-- ============================================================
         MAGNETOMETER SENSOR PLUGIN (custom - replaces the native
         gz-sim-magnetometer-system)
         Author (this addition): controls-integration specialist agent,
         2026-08-27, SENSOR_MODEL_AND_ARDUPLANE_SITL_PREPARATION bug-fix
         follow-up.

         WHY A CUSTOM PLUGIN: the previously-used native gz-sim
         <sensor type="magnetometer"> + world-level
         gz-sim-magnetometer-system pairing (see the REMOVED-sensor comment
         under base_link above) was live-validated by gazebo-testing to
         publish a constant ~0.32-magnitude field_tesla output that does
         NOT respond to the declared world <magnetic_field> value at all
         (ratio 1.0000 under a 100x scale test) - a confirmed, reproducible
         defect in the installed gz-sim8/gz-sensors8 binaries on this
         machine (no source available to patch; see
         plugins/sensors/MagnetometerSystem.hh header comment for the full
         gdb-verified evidence trail: the world's declared field DOES reach
         gz::sensors::v8::MagnetometerSensor::SetWorldMagneticField()
         correctly - the defect is downstream of that, inside the
         installed binary's own Update()/publish path, which this agent
         could not further debug without source and which never actually
         triggers the exported Update() symbol despite the sensor visibly
         publishing - see header comment). This plugin follows the exact
         same architectural precedent as FalconV2Pitot above (native path
         confirmed unusable for this project's need).

         Publishes on the SAME topic the native sensor used
         (/model/falcon_v2/sensors/mag), same message type
         (gz.msgs.Magnetometer, field_tesla, body FLU frame, zero relative
         rotation to base_link) - no downstream consumer needs to change.
         Field computation is orientation-only (reads base_link's own
         world orientation from the ECM, rotates the fixed world-frame
         field below into body frame via RotateVectorReverse - the same
         convention already used for this project's IMU specific-force
         reading); it has no lever-arm/velocity dependence, so unlike the
         pitot's mount_offset_body, no mount-point parameter is needed
         here. -->
    <plugin filename="FalconV2Magnetometer" name="falcon_v2_sensors::MagnetometerSystem">
      <!-- Fixed Earth magnetic field vector, WORLD (ENU) frame, Tesla.
           SIMULATION_ASSUMPTION: identical numeric value to what this
           project's world file already declared via <magnetic_field>
           (sdformat's own documented world-element default,
           /usr/share/sdformat14/1.11/world.sdf) - see SENSORS.md sec 4.4.
           The real Falcon V2 flight-location-specific magnetic field
           remains DATA_REQUIRED. -->
      <world_magnetic_field_tesla>5.5645e-6 22.8758e-6 -42.3884e-6</world_magnetic_field_tesla>
      <!-- V1_PROVISIONAL update rate - matches the value already
           documented/used for the (now-replaced) native sensor, see
           SENSORS.md sec 6. -->
      <update_rate_hz>50.0</update_rate_hz>
      <!-- gz.msgs.Magnetometer, field_tesla (T), body FLU frame. -->
      <topic>/model/falcon_v2/sensors/mag</topic>
    </plugin>

    <!-- ============================================================
         ARDUPILOT SITL TRANSPORT PLUGIN (official ardupilot_gazebo
         ArduPilotPlugin - NOT this project's own code)
         Author (this addition): controls-integration specialist agent,
         2026-08-27, task
         ARDUPLANE_SITL_TRANSPORT_AND_ACTUATOR_MAPPING_VALIDATION.

         Purely additive: no link/joint/mass/CG/inertia/collision/visual
         element, and no other <plugin> block above (aerodynamics/
         propulsion/actuators/wind/pitot/magnetometer), is modified by this
         block. Binary: /home/emirhan/gazebo_sim/ardupilot_gazebo/build/
         libArduPilotPlugin.so (already built, already on
         GZ_SIM_SYSTEM_PLUGIN_PATH - not built or modified by this task).

         SCOPE (hard boundary, do not exceed - see task brief): transport +
         command-mapping ONLY. Every one of the 7 <control> blocks below
         uses type=COMMAND, which ArduPilotPlugin.cc's own
         ApplyMotorForces() (confirmed by direct source read) handles by
         publishing a gz.msgs.Double to <cmd_topic> and then
         unconditionally `continue`-ing - it NEVER reaches the
         JointForceCmd/JointVelocityCmd/PID-effort code path for a COMMAND
         channel, i.e. ArduPlane NEVER drives any of these joints directly
         via force/velocity/position PID. <useForce>0</useForce> is set
         explicitly below on every block anyway (defense in depth): without
         it, ArduPilotPlugin's own Reset() function (called on simulation
         reset/seek, separate from ApplyMotorForces()) would still create a
         zero-initialized JointForceCmd component on these joints, since
         useForce defaults to true in the plugin's own source - harmless in
         practice (COMMAND type never writes a nonzero value into it via
         ApplyMotorForces()) but unnecessary, so it is disabled explicitly
         to honor this project's "never useForce=1 on our control-surface/
         motor joints" rule literally, not just in the common-case code
         path. Full design record, sign-convention pre-registration, and
         the GPS/baro/mag/airspeed architecture finding referenced below:
         docs/source_of_truth/autopilot/
         SITL_TRANSPORT_AND_ACTUATOR_MAPPING.md - not repeated in full
         here.

         TRANSPORT: UDP JSON, matching ArduPilotPlugin's own compiled
         defaults exactly (restated explicitly here for documentation/
         discoverability, not because the defaults were wrong).
         connectionTimeoutMaxCount=10 = plugin's own compiled default
         (ArduPilotPlugin.cc line ~509), not overridden - no project-
         specific reason to change it this stage. lock_step=1 chosen
         (matches ardupilot_gazebo's own zephyr_with_ardupilot reference
         example, deterministic step-for-step sim<->SITL synchronization,
         no free-running clock drift) - the appropriate choice for this
         project's physically-defensible-simulation goal; lock_step=0 was
         not chosen (would let ArduPlane's own wall-clock free-run ahead of
         or behind Gazebo's physics steps, an unnecessary source of
         nondeterminism this project has no reason to accept).

         FRAME OVERRIDES - LIVE/EMPIRICAL FINDING (see design doc sec 4 for
         the full derivation): modelXYZToAirplaneXForwardZDown is LEFT AT
         ITS COMPILED DEFAULT (no override below) - CONFIRMED correct for
         FALCON V2's own genuinely-FLU body frame (CLAUDE.md): the default
         Pose3d(0,0,0,GZ_PI,0,0) (pure 180 deg roll about body X) maps
         (X-fwd,Y-left,Z-up) -> (X-fwd,Y-right,Z-down) exactly, i.e. FLU ->
         FRD, verified by direct computation with the exact gz.math7
         Quaterniond/RotateVector API the plugin itself uses (not merely
         asserted from the in-source comment, which this task's brief
         correctly flagged as unreliable/copy-pasted).
         gazeboXYZToNED IS EXPLICITLY OVERRIDDEN below, contrary to this
         task's own initial "CONFIRMED FAVORABLE" hint - that hint did NOT
         survive live verification: the compiled default
         Pose3d(0,0,0,GZ_PI,0,0) is NOT a correct world-frame ENU->NED
         conversion (it only flips Gazebo world Y/Z sign while leaving
         Gazebo's own +X-world axis mapped into NED's NORTH slot, i.e. it
         silently swaps "East" and "North" - confirmed numerically this
         task via gz.math7's own Quaterniond.RotateVector, the exact API
         the plugin calls: rotating a pure +X-world/"East" unit vector by
         the default override yields (1,0,0), i.e. it reads out as pure
         NED-North, not NED-East). The override used here,
         "0 0 0 180 0 90" (matching ardupilot_gazebo's own
         zephyr_with_ardupilot reference example's choice for this SAME
         tag), was verified with the identical method to correctly map a
         pure Gazebo-world +X/"East" vector to pure NED-East (0,1,0) and a
         pure Gazebo-world +Y/"North" vector to pure NED-North (1,0,0).
         This project's own world files all declare
         <spherical_coordinates><world_frame_orientation>ENU</...>
         (tests/gazebo/worlds/*.sdf, confirmed by grep for this task), so
         this correction applies to every world this model is loaded into,
         not a one-off. -->
    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <!-- Port settings - all restated explicitly even where they equal
           the plugin's own compiled default, per this project's existing
           documentation convention (see aerodynamics/propulsion plugin
           blocks above). fdm_port_in=9002 matches ArduPilot's own JSON
           backend compiled default control_port (SIM_JSON.h,
           /home/emirhan/gazebo_sim/ardupilot/libraries/SITL/SIM_JSON.h
           line 63) - confirmed by direct source read, not assumed: a bare
           `-M json` / `-f json` SITL launch on localhost requires no
           address/port arguments to connect to this plugin. -->
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>10</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>

      <!-- Body-frame override: NONE (compiled default retained). See the
           FRAME OVERRIDES header comment above for the live-verified
           reasoning. -->

      <!-- World-frame override: REQUIRED, live-verified - see the FRAME
           OVERRIDES header comment above. -->
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>

      <!-- Sensors: scoped name of the dedicated ArduPilot-bridge IMU relay
           sensor added above under base_link - NOT imu_sensor (see that
           new sensor block's own header comment for why a second instance
           is required). "::"-delimited, LINK-RELATIVE-TO-MODEL form
           (link::sensor, no leading model name) - LIVE-VERIFIED this task,
           not copied blindly from zephyr_with_ardupilot's own
           "zephyr::imu_link::imu_sensor" example: entitiesFromScopedName()
           is called with _relativeTo=this model's own entity
           (ArduPilotPlugin.cc ~line 1123), and per gz::sim::Util.hh's own
           documented contract "The scoped name does not include the name
           of [_relativeTo entity]" - zephyr's 3-segment name only works
           because zephyr_with_ardupilot NESTS a separate sub-model named
           "zephyr" via <include> (so "zephyr" there is an intermediate
           model, not the relativeTo entity's own name); FALCON V2 is a
           single flat (non-nested) <model name="falcon_v2">, so a leading
           "falcon_v2::" prefix is NOT valid here - CONFIRMED empirically
           this task: "falcon_v2::base_link::imu_sensor_ardupilot" and
           "world::falcon_v2::base_link::imu_sensor_ardupilot" both FAILED
           live ("imu_sensor [...] not found, abort ArduPilot plugin.");
           "base_link::imu_sensor_ardupilot" (used below) and the bare
           "imu_sensor_ardupilot" both resolved with no error. This is the
           ONLY sensor genuinely in-the-loop through this bridge -
           GPS/baro/magnetometer/airspeed are NOT read from any of this
           project's native/custom Gazebo sensors through this plugin; see
           the design doc's GPS/baro/mag/airspeed architecture finding
           (this is standard ArduPilot JSON/FDM-backend behavior, not a
           defect introduced by this project). -->
      <imuName>base_link::imu_sensor_ardupilot</imuName>

      <!-- ============================================================
           SERVO/MOTOR COMMAND MAPPING - 7 COMMAND-type channels (2
           aileron + 2 elevator + 1 rudder + 2 throttle), fanning out
           ArduPlane's 5 logical SERVOx outputs onto this project's 7
           existing actuator/propulsion command topics. Formula (confirmed
           exact from ArduPilotPlugin.cc's UpdateMotorCommands(), not
           assumed):
             raw_cmd = clamp((pwm - servo_min) / (servo_max - servo_min), 0, 1)
             cmd     = multiplier * (raw_cmd + offset)
           servo_min/servo_max below are copied EXACTLY from the real
           SERVOx_MIN/MAX values in config/ardupilot/falcon_v2_sitl.parm
           (REAL_PARAM_CONFIGURATION, not invented). offset=-0.5 on every
           angular (non-throttle) channel centers PWM=SERVOx_TRIM (=1500,
           exact raw_cmd midpoint for MIN=800/MAX=2200) at cmd=0 rad
           (neutral, matching plugins/actuators/ActuatorSystem.cc's own
           0=neutral convention). multiplier = +/-1.5707963268 rad (= +/-pi/2,
           NOT +/-45deg-in-radians directly - see derivation below) maps
           ArduPlane's full raw_cmd [0,1] swing onto a +/-45 deg physical
           target range. UPDATED (ARDUPLANE_CONTROL_SURFACE_TRAVEL_SCALING_
           VALIDATION, 2026-08-28) from the prior stage's +/-0.3490658504 rad
           (+/-10 deg) PROVISIONAL_INTERFACE_LIMIT - see
           docs/source_of_truth/autopilot/
           SITL_TRANSPORT_AND_ACTUATOR_MAPPING.md sec 11 for the full
           derivation/rationale/TXT-cross-check record. Because cmd is only
           ever evaluated at raw_cmd in [0,1] and offset=-0.5, the realized
           output range is cmd in [-0.5*multiplier, +0.5*multiplier], i.e.
           HALF the multiplier's own value, not the multiplier itself -
           +/-45 deg therefore requires multiplier = 2*45deg-in-radians =
           +/-1.5707963268 rad (=pi/2), NOT +/-0.7853981634 rad (45deg
           itself, which would only realize +/-22.5 deg - do not make this
           substitution). This now matches
           docs/source_of_truth/controls/actuator_v1_config.yaml's own
           +/-0.7853981634 rad (+/-45deg) MECHANICAL_ACTUATOR_LIMIT_V1 joint
           <limit> exactly - the bridge no longer artificially restricts
           ArduPlane's commanded range below the joint's own mechanical
           ceiling; both layers now agree at +/-45 deg. Sign per
           channel (multiplier sign only, UNCHANGED by this update - see the
           design doc for the full pre-registered physical-direction
           reasoning per surface, task section 36/37/38 requirement): NOT
           re-derived in this comment, see docs/source_of_truth/autopilot/
           SITL_TRANSPORT_AND_ACTUATOR_MAPPING.md sec 3.
           useForce=0 on every block - see this plugin's own header comment
           above. jointName is a formally-required-but-functionally-inert
           reference for COMMAND type (ArduPilotPlugin.cc ~line 604-621:
           parsed and validated to exist, never actually driven for
           COMMAND type) - the actually-relevant joint per channel is used
           for clarity. ============================================== -->

      <!-- Aileron (SERVO1: FUNCTION=4, MIN=800, MAX=2200, TRIM=1500,
           REVERSED=1 - config/ardupilot/falcon_v2_sitl.parm) -> LEFT
           aileron. Y-split fan-out (PROVISIONAL_WIRING_ASSUMPTION, one
           logical ArduPlane Aileron output feeds both physical servos -
           SITL_PARAM_MIGRATION.md sec 2/14). multiplier sign: see design
           doc sec 3 (left/right must be OPPOSITE per the verified
           delta_a_aero = +0.5*(theta_right-theta_left) mapping,
           CONTROLS.md sec 10). -->
      <control channel="0">
        <jointName>left_aileron_joint</jointName>
        <useForce>0</useForce>
        <type>COMMAND</type>
        <cmd_topic>/model/falcon_v2/actuators/left_aileron/cmd_rad</cmd_topic>
        <multiplier>1.5707963268</multiplier>
        <offset>-0.5</offset>
        <servo_min>800</servo_min>
        <servo_max>2200</servo_max>
      </control>

      <!-- Aileron (SERVO1) -> RIGHT aileron, same channel, OPPOSITE sign
           (differential Y-split - see design doc sec 3). -->
      <control channel="0">
        <jointName>right_aileron_joint</jointName>
        <useForce>0</useForce>
        <type>COMMAND</type>
        <cmd_topic>/model/falcon_v2/actuators/right_aileron/cmd_rad</cmd_topic>
        <multiplier>-1.5707963268</multiplier>
        <offset>-0.5</offset>
        <servo_min>800</servo_min>
        <servo_max>2200</servo_max>
      </control>

      <!-- Elevator (SERVO2: FUNCTION=19, MIN=800, MAX=2200, TRIM=1500,
           REVERSED=0) -> LEFT elevator. Y-split fan-out (same
           PROVISIONAL_WIRING_ASSUMPTION as aileron). multiplier sign: SAME
           sign as the right-elevator block below (left/right elevator
           must move in the SAME physical direction - verified
           delta_e_aero = -0.5*(theta_left+theta_right) mapping,
           CONTROLS.md sec 10). -->
      <control channel="1">
        <jointName>left_elevator_joint</jointName>
        <useForce>0</useForce>
        <type>COMMAND</type>
        <cmd_topic>/model/falcon_v2/actuators/left_elevator/cmd_rad</cmd_topic>
        <multiplier>1.5707963268</multiplier>
        <offset>-0.5</offset>
        <servo_min>800</servo_min>
        <servo_max>2200</servo_max>
      </control>

      <!-- Elevator (SERVO2) -> RIGHT elevator, same channel, SAME sign as
           left (common-mode pitch, not differential - see design doc). -->
      <control channel="1">
        <jointName>right_elevator_joint</jointName>
        <useForce>0</useForce>
        <type>COMMAND</type>
        <cmd_topic>/model/falcon_v2/actuators/right_elevator/cmd_rad</cmd_topic>
        <multiplier>1.5707963268</multiplier>
        <offset>-0.5</offset>
        <servo_min>800</servo_min>
        <servo_max>2200</servo_max>
      </control>

      <!-- Rudder (SERVO4: FUNCTION=21, MIN=800, MAX=2200, TRIM=1500,
           REVERSED=1) -> rudder (single centerline surface, no split). -->
      <control channel="3">
        <jointName>rudder_joint</jointName>
        <useForce>0</useForce>
        <type>COMMAND</type>
        <cmd_topic>/model/falcon_v2/actuators/rudder/cmd_rad</cmd_topic>
        <multiplier>-1.5707963268</multiplier>
        <offset>-0.5</offset>
        <servo_min>800</servo_min>
        <servo_max>2200</servo_max>
      </control>

      <!-- ThrottleLeft (SERVO3: FUNCTION=73, MIN=1000, MAX=2000,
           TRIM=1000 [==MIN, idle-low, standard for a throttle-type
           function, not a bug], REVERSED=0) -> left motor. multiplier=1,
           offset=0 gives cmd directly in [0,1], matching
           plugins/propulsion/PropulsionSystem.cc's OnThrottleLeft()
           std::clamp(msg.data(),0.0,1.0) domain exactly (confirmed by
           direct source read) - 1:1, no sign flip, per this task's own
           instruction. jointName points at left_prop_joint (inert
           placeholder requirement only for COMMAND type - see header
           comment). -->
      <control channel="2">
        <jointName>left_prop_joint</jointName>
        <useForce>0</useForce>
        <type>COMMAND</type>
        <cmd_topic>/model/falcon_v2/propulsion/left/throttle_cmd</cmd_topic>
        <multiplier>1.0</multiplier>
        <offset>0.0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
      </control>

      <!-- ThrottleRight (SERVO5: FUNCTION=74, MIN=1000, MAX=2000,
           TRIM=1000, REVERSED=0) -> right motor, independent of
           ThrottleLeft (twin-motor independence preserved end-to-end, no
           mixing/averaging - SITL_PARAM_MIGRATION.md sec 14). -->
      <control channel="4">
        <jointName>right_prop_joint</jointName>
        <useForce>0</useForce>
        <type>COMMAND</type>
        <cmd_topic>/model/falcon_v2/propulsion/right/throttle_cmd</cmd_topic>
        <multiplier>1.0</multiplier>
        <offset>0.0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
      </control>
    </plugin>

  </model>
</sdf>
