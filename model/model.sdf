          <box>
            <size>0.061119 0.479366 0.020953</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- Mekanik limit +/-45 derece (0.7853981634 rad), etiket
         MECHANICAL_ACTUATOR_LIMIT_V1. İKİ AYRI KAVRAM, BİRBİRİNE
         KARIŞTIRILMAMALI:
           (1) MEKANİK hareket kabiliyeti = +/-45 derece = 0.7853981634 rad,
               etiket USER_CONFIRMED_MECHANICAL_CAPABILITY. Aşağıdaki
               <limit> elemanı tam olarak bunu kodlar: servonun veya
               joint'in fiziksel olarak ulaşabileceği açı.
           (2) AERODİNAMİK OLARAK DOĞRULANMIŞ saptırma aralığı. Bu ayrı ve
               daha dar bir sorudur, <limit> onu kodlamaz. +/-45 derece,
               aerodinamik modelin o açıya kadar doğrusal olduğu iddiası
               değildir.
         Joint dönüş işareti geometri işaret testiyle doğrulanmıştır:
         VERIFIED_BY_GAZEBO_GEOMETRY_SIGN_TEST. -->
    <joint name="left_aileron_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_aileron</child>
      <axis>
        <xyz>0.000994 0.999899 0.014146</xyz>
        <limit>
          <lower>-0.7853981634</lower>
          <upper>0.7853981634</upper>
        </limit>
      </axis>
    </joint>

