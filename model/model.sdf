    <!-- ============================================================
         LEFT PROP: movable link, strategy (B). Link origin at the real
         physical prop hub (CONFIRMED, master dataset section 46,
         GEOMETRY.md section 7).

         Link origin (m):        (0.2951, 0.3000, 0.1271)
         VISUAL scale APPLIED: 0.001208 (= 0.001 * 1.208 visual-only
         enlargement, see header comment and PROPULSION.md section
         0/21.2).
         Visual pose offset T = -1.208 * hub_position_m, so the enlarged
         disk stays centered on the true hub:
                                  (-0.356481, -0.362400, -0.153537)
         Verified numerically: hub vertex (295.084,300.007,127.073 mm
         raw) reproduces to (0.29508, 0.30001, 0.12707) m, within 0.1 mm
         of the true hub (0.2951, 0.3000, 0.1271) m.
         Mass: 0.0301 kg - REAL, CONFIRMED component mass (master dataset
         section 44), NOT TEMPORARY_NUMERICAL_MASS. Subtracted from
         base_link.
         Rotational inertia: V1_PROVISIONAL_ROTATIONAL_INERTIA. Exact
         prop rotational inertia is NOT known (PROPULSION.md section
         1.1/4: "Exact rotational inertia henuz bilinmiyor"). This value
         is a simple uniform-thin-rod approximation using the REAL mass
         (0.0301 kg) and REAL diameter (D=0.3302 m, APC 13x6.5E, never
         the STL mesh figure): I = (1/12)*m*D^2 = 2.7349e-4 kg*m^2,
         applied identically to all three axes (Ixx=Iyy=Izz) as a
         simplifying symmetric approximation that deliberately ignores
         the arbitrary instantaneous blade-angle asymmetry of the
         exported mesh pose. This is a placeholder for the
         spin-up/spin-down dynamics a future propulsion plugin will need
         (PROPULSION.md section 4), NOT a measured or CAD value.
         Rotation direction: physical fact only, NOT enforced by this
         joint, see header comment ("PROPELLER LINKS/JOINTS").
         No collision geometry (see header comment).
         ============================================================ -->
    <link name="left_prop">
      <pose>0.2951 0.3000 0.1271 0 0 0</pose>

      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.0301</mass>
        <inertia>
          <ixx>2.7349e-04</ixx>
          <iyy>2.7349e-04</iyy>
          <izz>2.7349e-04</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="left_prop_visual">
        <pose>-0.356481 -0.362400 -0.153537 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/left_pervane.stl</uri>
            <!-- VISUAL_MESH_ONLY scale correction: 0.001 * 1.208. Never
                 use this scale factor, or the resulting approx 0.2734 m
                 mesh diameter, in any physics/propulsion calculation.
                 Real physical diameter for physics is always D=0.3302 m
                 (PROPULSION.md section 0). -->
            <scale>0.001208 0.001208 0.001208</scale>
          </mesh>
        </geometry>
      </visual>
    </link>

    <!-- Continuous-rotation joint: revolute with a very large limit (no
         dedicated SDF "continuous" joint type exists). Axis = +X (master
         dataset section 48, essentially pure +X, approx 0.153 deg
         measured offset not applied here: V1 uses the idealized +X per
         task instruction). Rotation direction (left=CCW) is a documented
         physical fact, not enforced by this joint definition (no
         propulsion plugin exists yet to command a signed velocity). -->
    <joint name="left_prop_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_prop</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
