      <!-- ============================================================
           SENSOR SUITE V1 (author: controls-integration, 2026-08-27, task
           SENSOR_MODEL_AND_ARDUPLANE_SITL_PREPARATION). Native gz-sim
           System-plugin-backed sensors (IMU/GPS/baro/magnetometer) - the
           system plugins that process these <sensor> elements are loaded
           at the WORLD level (see tests/gazebo/worlds/
           falcon_v2_sensors_selftest_world.sdf), not here.

           MOUNT LOCATION (all 4, plus the separate custom pitot plugin
           below): co-located with the Gazebo/CAD CG,
           (0.168309, 0, 0.100000) m - the SAME point already authoritative
           for this link's <inertial><pose> above (CLAUDE.md). DOCUMENTED
           CHOICE, not an arbitrary number: the real physical mounting
           location of any sensor on the real Falcon V2 airframe is
           DATA_REQUIRED (no CAD/manual placement data exists in this
           repository for avionics), so this V1 model uses the one
           documented, authoritative point already on this airframe rather
           than inventing an unsourced offset - this also avoids
           introducing an unvalidated lever-arm velocity effect
           (V_point = V_cg + omega x r) that no real data could confirm.
           Tag: SIMULATION_ASSUMPTION (mount point), applies to all 5
           sensors (4 native below + the pitot plugin, model-level, near
           the end of this file).

           NOISE: OFF by default in every sensor below (zero-noise
           deterministic mode, the default/validated mode per task
           instruction) - no <noise> sub-element is present. A V1_PROVISIONAL
           optional noise block is shown COMMENTED OUT under each sensor for
           future use; see docs/source_of_truth/sensors/SENSORS.md sec 7 for
           the full noise-status record (tag V1_PROVISIONAL_SENSOR_NOISE).

           UPDATE RATES: none are Falcon-specific/Cube-Orange-specific
           datasheet values (none ingested into this repository) - each is a
           documented, order-of-magnitude-reasonable V1_PROVISIONAL choice,
           see SENSORS.md sec 6 for the per-sensor rationale and citations
           (including gz-sim's own upstream demo world defaults where used
           as a reference point).
           ============================================================ -->

      <!-- IMU: orientation_reference_frame=CUSTOM, parent_frame="world",
           custom_rpy="0 0 0" (NOT the "ENU" localization string, and NOT
           the "boot-relative" CUSTOM-with-empty-parent_frame default). This
           choice is deliberate for CLARITY, not because "ENU" was found
           broken: the imu.sdf spec documents parent_frame="world",
           custom_rpy="0 0 0" as an explicit, unambiguous alternative ("IMU
           reports in Gazebo world frame") that avoids depending on
           interpreting the ENU-string's own indirection through
           SphericalCoordinates. This task EMPIRICALLY VERIFIED the choice
           actually used here (paused server, single/double physics step
           via /world/.../control multi_step, so the model has not yet had
           time to accumulate any real rotation from free-fall/aero
           dynamics) against
           tests/gazebo/worlds/falcon_v2_sensors_selftest_world.sdf's
           identity-attitude spawn pose: orientation = (w=0.999999,
           x~0, y=0.0016, z~0) - correctly near-identity (the small
           residual is a genuine, expected physical effect: a tiny
           aero-torque-driven angular rate had already begun accumulating
           over those 2 ms, confirmed consistent with the SAME run's own
           angular_velocity.y=0.080 rad/s reading at that instant, not a
           frame-convention artifact). An EARLIER same-task live sample
           taken several real seconds into an unpaused, uncontrolled
           free-fall run showed a very different, large-angle orientation
           and angular_velocity.y ~ 8.9 rad/s - initially mistaken for a
           possible localization quirk, but confirmed by this controlled
           single-step re-test to instead be the aircraft GENUINELY
           tumbling (an unpowered, unstabilized airframe free-falling
           nose/wings-first from rest generates large, physically real aero
           moments at extreme angles of attack far outside the validated
           envelope - expected behavior for that test setup, not a sensor
           defect). Reported orientation quaternion = rotation of body-FLU
           relative to Gazebo world frame (CONFIRMED ENU, see Frames.hh
           header) - the direct input to plugins/sensors/Frames.hh's
           AttitudeFluEnuToFrdNed() for the future ArduPilot-bridge
           conversion to FRD/NED. Angular velocity and linear acceleration
           (specific force) are reported in the sensor's own frame = body
           FLU (zero relative rotation to base_link) - see SENSORS.md sec
           4.1 for the full frame derivation and REAL_CONFIG_REFERENCE
           citation for enable_orientation default (true, unchanged). -->
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <topic>/model/falcon_v2/sensors/imu</topic>
        <pose>0.168309 0 0.100000 0 0 0</pose>
        <imu>
          <orientation_reference_frame>
            <localization>CUSTOM</localization>
            <custom_rpy parent_frame="world">0 0 0</custom_rpy>
          </orientation_reference_frame>
        </imu>
        <!-- V1_PROVISIONAL_SENSOR_NOISE example (OFF - not applied unless
             uncommented and stddev values are sourced/updated):
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></z>
          </linear_acceleration>
        </imu>
        -->
      </sensor>

      <!-- ============================================================
           ARDUPILOT-BRIDGE IMU RELAY SENSOR (additive, NOT a modification
           of imu_sensor above). Author: controls-integration, 2026-08-27,
           task ARDUPLANE_SITL_TRANSPORT_AND_ACTUATOR_MAPPING_VALIDATION.

           WHY A SECOND IMU SENSOR INSTANCE: the installed
           ardupilot_gazebo ArduPilotPlugin (LoadImuSensors()/PreUpdate()
           in ArduPilotPlugin.cc) does NOT read the sensor's own SDF
           <topic> value - it independently computes its OWN subscribe
           topic as gz::sim::scopedName(imuEntity, ecm) + "/imu" (the
           gz-sim AUTO-GENERATED default sensor topic form, i.e.
           "/world/<world>/model/falcon_v2/link/base_link/sensor/<sensor
           name>/imu"), confirmed by direct read of the installed plugin
           source (/home/emirhan/gazebo_sim/ardupilot_gazebo/src/
           ArduPilotPlugin.cc lines ~1160-1169). imu_sensor above declares
           a CUSTOM <topic> (/model/falcon_v2/sensors/imu, already
           validated/consumed elsewhere in this project) - per gz-sensors'
           own behavior (EMPIRICALLY CONFIRMED this task via `gz topic -l`
           against both a custom-topic sensor and a no-topic sensor in a
           throwaway probe world: a sensor with an explicit <topic>
           publishes ONLY on that custom topic, never additionally on the
           auto-generated default), ArduPilotPlugin's computed topic would
           NEVER match imu_sensor's real topic - imuMsgValid would never
           become true and CreateStateJSON() would silently never build a
           packet, i.e. the bridge would structurally never send ANY FDM
           data to ArduPlane, not merely report wrong numbers. Per this
           task's explicit instruction, imu_sensor above (prior-stage
           READY output) is NOT modified to work around this - instead
           this second, ArduPilot-bridge-ONLY sensor instance is added,
           deliberately WITHOUT a <topic> element, so gz-sim's own Sensors
           system assigns it the exact auto-generated default topic that
           ArduPilotPlugin's own scopedName()+"/imu" computation expects
           (CONFIRMED equal by construction - both use the same
           gz::sim::scopedName() free function against the same entity
           tree - and empirically verified this task by adding an
           identical no-topic probe IMU sensor to a scratch copy of this
           model in a throwaway world and reading its real topic via
           `gz topic -l`: it exactly matched the
           "/world/<world>/model/<model>/link/<link>/sensor/<name>/imu"
           pattern). Mount point, orientation_reference_frame, update
           rate, and zero-noise mode are all IDENTICAL to imu_sensor above
           (same physical IMU, same already-validated FLU/world-orientation
           convention - SENSORS.md sec 4.1 - this is a transport-layer
           duplicate for ArduPilot's exclusive use, not a second physical
           sensor model or a second set of validated numbers), EXCEPT for
           its <pose> ROTATION component - see the
           FLU->FRD GYRO/ACCEL FIX comment immediately below. Full record:
           docs/source_of_truth/autopilot/
           SITL_TRANSPORT_AND_ACTUATOR_MAPPING.md. -->

      <!-- ============================================================
           FLU->FRD GYRO/ACCEL FIX (controls-integration, 2026-08-27,
           bug-fix follow-up to the above, same task). CRITICAL defect
           found live by gazebo-testing (docs/test_results/
           2026-08-27_ardupilot_sitl_transport_actuator_mapping_
           validation.md sec 5): ArduPilotPlugin::CreateStateJSON()
           (source-read, ArduPilotPlugin.cc, ~lines 1739-1856) writes this
           sensor's raw imuMsg.angular_velocity()/linear_acceleration()
           straight into the JSON "gyro"/"accel_body" fields with ZERO
           rotation applied - modelXYZToAirplaneXForwardZDown (the
           FLU->FRD body-frame transform, GZ_PI about X, see gazeboXYZToNED
           discussion above) is composed and used ONLY for
           position/velocity/quaternion in this plugin version, never for
           the IMU message. Confirmed live: with a zero-rotation <pose>,
           roll-axis gyro read back correctly (FLU +X = FRD +X, no flip
           needed) but pitch/yaw showed NO sign flip at all - raw FLU
           reaching ArduPlane's FRD-assuming AHRS/EKF unconverted (root
           cause of the persistent "AHRS: DCM Roll/Pitch inconsistent"
           prearm failure that session).

           FIX: since ArduPilotPlugin never rotates the IMU message itself,
           the correction is baked into THIS sensor's own mounting
           ROTATION (position offset unchanged) instead - a 180 deg
           rotation about body X, numerically IDENTICAL to
           modelXYZToAirplaneXForwardZDown's own compiled default
           (Pose3d(0,0,0,GZ_PI,0,0)) and to plugins/sensors/Frames.hh's
           already-tested FluFrdSwap()/kQFluToFrdRot (same 180 deg-about-X
           quaternion, reused here, not re-derived).

           VERIFIED CORRECT against gz-sim8/gz-sensors8 source before
           applying (not assumed) - this is NOT a cosmetic mounting
           label, it genuinely changes the sensor's raw output:
           - gz-sim Physics.cc (systems/physics/Physics.cc, "body angular
             velocity"/"body linear acceleration" blocks, ~line 3807/3854):
             for a non-link entity (e.g. a sensor) with a <pose> offset
             from its parent link, the reported components::AngularVelocity/
             LinearAcceleration are computed as
             entityWorldPose.Rot().RotateVectorReverse(entityWorldVec) -
             i.e. the WORLD-frame vector is rotated into the entity's OWN
             FULLY-COMPOSED world orientation (parent link rotation
             CHAINED WITH this sensor's own local <pose> rotation), not
             just the parent link's orientation. So a rotation on this
             <pose> element genuinely rotates the raw gyro/accel this
             sensor reports, exactly like a physically re-oriented chip
             would.
           - gz-sensors ImuSensor::Update() (ImuSensor.cc ~line 231-235)
             rotates gravity into this same fully-composed local frame
             for the accelerometer's specific-force contribution
             (worldPose.Rot().Inverse().RotateVector(gravity)) - i.e.
             accel_body gets the SAME rotation consistently, gravity
             compensation included.
           - Algebra check: RotateVectorReverse by a pure 180 deg-about-X
             rotation R (self-inverse, R=diag(1,-1,-1)) applied on top of
             the already-FLU link-frame vector gives (x,-y,-z) -
             EXACTLY FluFrdSwap(). For a pure body +X (roll) rate this
             leaves X unchanged (matches the already-correct, must-not-
             break roll-axis result); for pure +Y (pitch) or +Z (yaw)
             rates it flips sign - matches the required FLU->FRD
             conversion on those two axes.
           - This sensor's own "orientation" quaternion output (gz.msgs.
             IMU.orientation) DOES change as a side effect (its
             orientationReference is captured at the new, rotated initial
             pose) but is IRRELEVANT here: CreateStateJSON() (confirmed by
             source read) never reads this sensor's orientation field at
             all - ArduPilot's quaternion/position/velocity come from a
             separate, already-validated wldAToBdyA-transformed pose
             pipeline, untouched by this change.

           Scope: this fix touches ONLY imu_sensor_ardupilot's <pose>
           rotation. imu_sensor above (the original, prior-stage-validated
           sensor feeding plugins/sensors/ diagnostics) is NOT touched -
           its own FLU->FRD conversion (where needed) is handled entirely
           in software via Frames.hh::FluFrdSwap(), a different, already-
           validated mechanism appropriate for that sensor's own
           consumers. -->
      <sensor name="imu_sensor_ardupilot" type="imu">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <pose degrees="true">0.168309 0 0.100000 180 0 0</pose>
        <imu>
          <orientation_reference_frame>
            <localization>CUSTOM</localization>
            <custom_rpy parent_frame="world">0 0 0</custom_rpy>
          </orientation_reference_frame>
        </imu>
      </sensor>

      <!-- GPS (navsat): reports lat/lon/alt (WGS84, per world
           spherical_coordinates) and velocity_east/north/up explicitly
           (gz.msgs.NavSat, CONFIRMED via navsat.proto) - i.e. ENU by
           construction, no ambiguity. Position reference origin is the
           world's <spherical_coordinates> block
           (lat=0,lon=0,elevation=0 - PLACEHOLDER_ORIGIN, DATA_REQUIRED for
           Falcon's real flight-test location, see SENSORS.md sec 5). -->
      <sensor name="gps_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>5</update_rate>
        <topic>/model/falcon_v2/sensors/gps</topic>
        <pose>0.168309 0 0.100000 0 0 0</pose>
      </sensor>

      <!-- Barometer (air_pressure): publishes gz.msgs.FluidPressure (Pa).
           reference_altitude=0 matches the world spherical_coordinates
           elevation=0 placeholder origin above - consistent, not a second,
           independently-chosen number. ArduPilot's own barometer backend
           converts pressure->altitude itself (out of scope here, next
           stage). -->
      <sensor name="baro_sensor" type="air_pressure">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <topic>/model/falcon_v2/sensors/baro</topic>
        <pose>0.168309 0 0.100000 0 0 0</pose>
        <air_pressure>
          <reference_altitude>0</reference_altitude>
        </air_pressure>
      </sensor>

      <!-- Magnetometer: REMOVED from here (2026-08-27 bug-fix follow-up,
           controls-integration). The native gz-sim <sensor type=
           "magnetometer"> + world-level gz-sim-magnetometer-system pairing
           that used to live at this location was live-validated by
           gazebo-testing (docs/test_results/
           2026-08-27_sensor_model_sitl_preparation.md sec 5) to publish a
           constant ~0.32-magnitude field_tesla output, completely
           unresponsive to a 100x change in the declared world
           <magnetic_field> value - a confirmed, reproducible TEST_FAILED,
           not a sign/frame/config error in this repository's SDF (this
           agent independently reproduced the same defect via live gdb
           instrumentation of the installed
           libgz-sensors8-magnetometer.so.8.2.2 - see
           plugins/sensors/MagnetometerSystem.hh header comment for the
           full evidence trail). Replaced by the custom
           FalconV2Magnetometer plugin (model-level <plugin> block near
           FalconV2Pitot below, same architectural pattern), which
           publishes on the SAME topic (/model/falcon_v2/sensors/mag,
           gz.msgs.Magnetometer, field_tesla, body FLU frame, zero relative
           rotation to base_link - so no downstream consumer needs to
           change) and genuinely consumes a documented Earth-field value -
           see SENSORS.md sec 4.4. -->
    </link>

    <!-- ============================================================
         LEFT AILERON: movable link, mesh-pose strategy (B): link origin
         placed at the fitted hinge line's root point (y=313.950 mm end
         of the XFLR5-active span, master dataset section 33), mesh
         visual/collision offset by the negative of that same point so
         the rendered mesh does not visually shift (link_origin +
         mesh_offset reproduces the mesh's own authored global position,
         verified numerically).

         CORRECTED this pass (validation review; see header comment
         "HINGE-AXIS FITTING METHOD" and GEOMETRY.md section 33.1 for full
         method/evidence): the secondary (Z/tilt) axis component below was
         re-derived with a deterministic method and a documented tip-
         outlier exclusion; the primary (X) component and link origin's
         X/Y are effectively unchanged (sub-0.001 m), Z changed by
         approx 0.5 mm.

         Link origin (m):      (0.032943, 0.313950, 0.110356)
         Mesh visual offset:  (-0.032943, -0.313950, -0.110356)
         Joint axis (unit vec, fitted hinge-line direction, dY=+1 sense):
                                (0.000994, 0.999899, 0.014146)
         Movable span reference (XFLR5-active): y = 0.313950 to 0.784875 m
         Hinge fit residual, PRIMARY/X (mm): RMS 0.0123, max 0.0204 (4
         stations). Hinge fit residual, SECONDARY/Z (mm): RMS 0.0020, max
         0.0028 (3 stations; y=784.875 mm excluded from the Z-fit only, as
         a tip-proximity artifact - see header comment; its X value is
         unaffected and still used).
         Hinge %chord evidence (master dataset section 33-34): approx
         69.75% to 72.14% band
         Mass: TEMPORARY_NUMERICAL_MASS = 0.001 kg (see header comment)
         Inertia: thin-box approximation using this link's own mesh
         bounding-box size (61.119 x 479.366 x 20.953 mm), about this
         link's own local mass-center estimate (its mesh bounding-box
         center): a geometric approximation for a near-massless
         placeholder link, not a claim of physical accuracy.
         ============================================================ -->
    <link name="left_aileron">
      <pose>0.032943 0.313950 0.110356 0 0 0</pose>

      <inertial>
        <pose>-0.025962 0.236107 0.007807 0 0 0</pose>
        <mass>0.001</mass>
        <inertia>
          <ixx>1.9186e-05</ixx>
          <iyy>3.4788e-07</iyy>
          <izz>1.9461e-05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="left_aileron_visual">
        <pose>-0.032943 -0.313950 -0.110356 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/left_aileron.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name="left_aileron_collision">
        <pose>-0.025962 0.236107 0.007807 0 0 0</pose>
        <geometry>
          <box>
            <size>0.061119 0.479366 0.020953</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- Mechanical limit +/-45 deg (0.7853981634 rad), tagged
         MECHANICAL_ACTUATOR_LIMIT_V1 (widened from the prior +/-30 deg
         MECHANICAL_INITIAL_LIMIT, task ACTUATOR_SERVO_MODEL_V1,
         controls-integration, 2026-08-23 - see the file-header
         "CONTROL-SURFACE JOINT LIMIT UPDATE" section above for the full
         MECHANICAL-vs-AERODYNAMIC-validity distinction, not repeated per
         joint). +/-45 deg is USER_CONFIRMED_MECHANICAL_CAPABILITY for this
         task, NOT a claim that the aerodynamic model is linear that far;
         the aero-validated linear range is still only approx +/-10 deg, a
         separate fact, CONTROLS.md section 3, UNCHANGED by this task. Joint
         rotation sign: SIGN_TEST_REQUIRED historically, now
         VERIFIED_BY_GAZEBO_GEOMETRY_SIGN_TEST (CONTROLS.md section 10) -
         unaffected by this limit change. -->
    <joint name="left_aileron_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_aileron</child>
      <axis>
        <xyz>0.000994 0.999899 0.014146</xyz>
        <limit>
          <lower>-0.7853981634</lower>
          <upper>0.7853981634</upper>
        </limit>
      </axis>
    </joint>

    <!-- ============================================================
         RIGHT AILERON: exact Y-mirror of left_aileron (link origin Y
         and axis X/Z-slope components negated), per the mesh's own
         confirmed Y-mirror symmetry (GEOMETRY.md section 22, deltas
         <=0.052 mm).
