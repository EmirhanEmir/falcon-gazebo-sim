    <!-- SOL PERVANE: hareketli link. Link orijini gerçek fiziksel
         pervane göbeğinde (CONFIRMED).

         Link orijini (m):     (0.2951, 0.3000, 0.1271)
         GÖRSEL ölçek: 0.001208 (= 0.001 x 1.208, yalnızca görsele özel
         büyütme).
         Görsel pose ofseti T = -1.208 x göbek_konumu_m, böylece büyütülmüş
         disk gerçek göbekte merkezli kalır:
                               (-0.356481, -0.362400, -0.153537)
         Sayısal doğrulama: ham göbek köşesi (295.084, 300.007, 127.073 mm)
         (0.29508, 0.30001, 0.12707) m olarak yeniden üretilir; gerçek
         göbek (0.2951, 0.3000, 0.1271) m değerine 0.1 mm'den yakın.
         Kütle: 0.0301 kg, GERÇEK ve CONFIRMED bileşen kütlesi,
         TEMPORARY_NUMERICAL_MASS DEĞİL. base_link'ten düşülmüştür.
         Dönme ataleti: V1_PROVISIONAL_ROTATIONAL_INERTIA. Pervanenin tam
         dönme ataleti BİLİNMİYOR. Buradaki değer, GERÇEK kütle (0.0301 kg)
         ve GERÇEK çap (D=0.3302 m, APC 13x6.5E; asla STL mesh çapı değil)
         ile basit tek biçimli ince çubuk yaklaşımıdır:
         I = (1/12) x m x D^2 = 2.7349e-04 kg*m^2. Üç eksene de aynı
         uygulanır (Ixx=Iyy=Izz); bu, ihraç edilmiş mesh pozundaki keyfi
         anlık kanat açısı asimetrisini bilinçle yok sayan simetrik bir
         basitleştirmedir. İleride itki eklentisinin ihtiyaç duyacağı
         spool up/down dinamiği için yer tutucudur, ölçülmüş veya CAD
         değeri değildir.

         DÖNME YÖNÜ yalnızca fiziksel bir olgu olarak kayıtlıdır, bu joint
         tarafından zorlanmaz: tek bir +X ekseni, bir eklenti işaretli hız
         veya tork komutlamadan önce kendiliğinden CCW/CW anlamı taşımaz.
         Kaynak veri yalnızca "sol pervane CCW, sağ pervane CW" bilgisini
         verir, BAKIŞ ÇERÇEVESİNİ (arkadan mı önden mi) belirtmez ve başka
         bir kaynak da belirtmez. Bakış noktası verilmeden CCW/CW fiziksel
         olarak anlamlı değildir, çünkü aynı dönüş şaftın bir ucundan CCW,
         diğer ucundan CW görünür. Bu nedenle bakış çerçevesi ayrıntısı
         DATA_REQUIRED'dır, varsayılmaz: işaretli hız komutu yazılmadan önce
         hangi bakış kuralına göre ölçüldüğü üretici kılavuzundan veya CAD
         kaynağından doğrulanmalıdır (SIGN_TEST_REQUIRED ve
         VIEWPOINT_CONFIRMATION_REQUIRED, ikisi de burada çözülmemiştir).
         Collision geometrisi yok; gerekçe için collision stratejisi
         yorumuna bakın. -->
    <link name="left_prop">
      <pose>0.2951 0.3000 0.1271 0 0 0</pose>

      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.0301</mass>
        <inertia>
          <ixx>2.7349e-04</ixx>
          <iyy>2.7349e-04</iyy>
          <izz>2.7349e-04</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="left_prop_visual">
        <pose>-0.356481 -0.362400 -0.153537 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/left_pervane.stl</uri>
            <!-- VISUAL_MESH_ONLY ölçek düzeltmesi: 0.001 x 1.208. Bu
                 ölçek faktörünü ve ondan çıkan yaklaşık 0.2734 m mesh
                 çapını hiçbir fizik veya itki hesabında kullanmayın.
                 Fizikte gerçek fiziksel çap her zaman D=0.3302 m'dir.
                 Düzgün ölçek tüm köşe koordinatlarını mesh'in kendi uzak
                 yerel orijini etrafında çarptığı için 0.001208'i doğrudan
                 uygulamak çizilen göbeği gerçek konumundan yaklaşık 60 mm
                 kaydırırdı; görsel <pose> ötelemesi bunu telafi eder. -->
            <scale>0.001208 0.001208 0.001208</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.65 0.16 0.015 1</ambient>
          <diffuse>1.0 0.32 0.025 1</diffuse>
          <specular>0.25 0.20 0.12 1</specular>
        </material>
      </visual>
    </link>

    <!-- Sürekli dönen joint: SDF'de ayrı bir "continuous" joint tipi
         bulunmadığı için çok büyük limitli (+/-1e16 rad) revolute joint
         kullanılır. Eksen = +X. Ölçülen pervane yüzeyi normali
         (+0.999996, +0.000018, -0.002668), yani yaklaşık 0.153 derecelik
         sapma ile neredeyse saf +X; bu sapma burada uygulanmaz,
         idealleştirilmiş +X kullanılır. Dönme yönü (sol = CCW) belgelenmiş
         bir fiziksel olgudur, bu joint tanımı tarafından zorlanmaz. -->
    <joint name="left_prop_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_prop</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <!-- SAĞ PERVANE: göbek konumu aynadır (Y işareti değişir). Mesh ise
         ayrı modellenmiş farklı bir fiziksel parçadır: gerçekte sağ el/CW
         hatveli bir pervanedir, sol pervane kanat geometrisinin basit bir Y
         aynası değildir. Buna karşın STL mesh bounding box yerleşimi
         0.015 mm altında bir farkla Y aynasıdır. Görsel ölçek düzeltmesi ve
         dönme ataleti gerekçesi sol pervaneyle aynıdır. -->
    <link name="right_prop">
      <pose>0.2951 -0.3000 0.1271 0 0 0</pose>

      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.0301</mass>
        <inertia>
          <ixx>2.7349e-04</ixx>
          <iyy>2.7349e-04</iyy>
          <izz>2.7349e-04</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="right_prop_visual">
        <pose>-0.356481 0.362400 -0.153537 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/right_pervane.stl</uri>
            <scale>0.001208 0.001208 0.001208</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.65 0.16 0.015 1</ambient>
          <diffuse>1.0 0.32 0.025 1</diffuse>
          <specular>0.25 0.20 0.12 1</specular>
        </material>
      </visual>
    </link>

    <joint name="right_prop_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_prop</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <!-- AERODİNAMİK EKLENTİSİ. Yukarıda tanımlı 5 kontrol yüzeyi
         joint'inin konumunu OKUR; onları komutlamaz ve yazmaz.

         Yapılandırılmış katsayı veri kümesi config/aero_v1_config.yaml
         olup Configure() anında yüklenir. Ne bu SDF bloğunda ne de
         eklentinin C++ kaynağında gömülü katsayı vardır.
         config_path Gazebo'nun çalışma dizinine göre çözülür, bu yüzden
         simülasyon depo kök dizininden başlatılmalıdır; verilen başlatma
         betikleri bunu yapar. -->
    <plugin filename="FalconV2Aerodynamics" name="falcon_v2_aero::AerodynamicsSystem">
      <config_path>config/aero_v1_config.yaml</config_path>
      <!-- YAML'deki air_density değerinin isteğe bağlı üzerine yazımı
           (kg/m^3). ISA deniz seviyesi varsayılanı 1.225, CONFIRMED. -->
      <air_density>1.225</air_density>
      <!-- gz.msgs.Vector3d topic'i, WORLD çerçevesi, m/s. Rüzgâr
           eklentisi (veya başka bir yayıncı) yayına başlayana kadar
           varsayılan sıfır rüzgârdır. -->
      <wind_topic>/model/falcon_v2/wind</wind_topic>
      <!-- Kısıtlanmış gz.msgs.Double_V tanı yayın hızı (Hz),
           /model/falcon_v2/aerodynamics/diagnostics üzerinde. Alan sırası:
           V, alpha_rad, beta_rad, qbar, CL, CD, CY, Cl, Cm, Cn. -->
      <diagnostics_rate_hz>20.0</diagnostics_rate_hz>
    </plugin>

    <!-- İTKİ EKLENTİSİ. Var olan left_prop_joint/right_prop_joint
         joint'lerinin açısal HIZINI her tick sürer; onları yeniden
         tanımlamaz.

         Zincir hiçbir zaman atlanmaz ve throttle x maksimum_itki biçiminde
         sadeleştirilmez: throttle, ESC/motor elektriği, motor torku, rotor
         açısal dinamiği (eklentinin kendi explicit Euler durumu, her tick
         entegre edilir), RPM, ilerleme oranı J, gerçek APC Ct(J,RPM) ve
         Cp(J,RPM), itki ve pervane aerodinamik torku, reaksiyon torku ve
         son olarak base_link'e gerçek göbekte (asla CG'de değil) uygulanan
         kuvvet/moment. Aynı omega durumu pervane joint'lerinin açısal
         hızını da sürdüğü için görsel dönüş, kuvveti üreten fizik RPM'inden
         asla ayrışamaz.

         Yapılandırılmış veri kümesi config/propulsion_v1_config.yaml olup
         Configure() anında yüklenir; ne bu SDF bloğunda ne de C++ kaynağında
         gömülü katsayı vardır. Gerçek APC 13x6.5E Ct(J)/Cp(J) verisi
         config/propulsion_data/apc_13x65e_parsed.csv dosyasındadır ve
         resmî APC performans dosyasından mekanik olarak ayrıştırılmıştır
         (config/propulsion_data/PROVENANCE.md).

         Throttle arayüzü: her motor kendi gz.msgs.Double topic'i üzerinden
         bağımsız komutlanır, [0,1] aralığına kırpılır ve hiç komut
         gelmezse 0 kabul edilir. ArduPlane SITL altında bu topic'leri bu
         dosyanın sonundaki ArduPilotPlugin kanalları sürer.

         config_path Gazebo'nun çalışma dizinine göre çözülür; simülasyon
         depo kök dizininden başlatılmalıdır. -->
    <plugin filename="FalconV2Propulsion" name="falcon_v2_propulsion::PropulsionSystem">
      <config_path>config/propulsion_v1_config.yaml</config_path>
      <!-- YAML'deki rho_kg_m3 değerinin isteğe bağlı üzerine yazımı
           (kg/m^3). ISA deniz seviyesi varsayılanı 1.225, CONFIRMED. -->
      <air_density>1.225</air_density>
      <!-- gz.msgs.Vector3d topic'i, WORLD çerçevesi, m/s. Aerodinamik
           eklentisinin abone olduğu topic'in aynısı (burada salt okuma);
           her motorun göbeğindeki bağıl akış V_axial için kullanılır. Bir
           yayıncı olana kadar sıfırdır. -->
      <wind_topic>/model/falcon_v2/wind</wind_topic>
      <!-- Motor başına throttle komut topic'leri, gz.msgs.Double, eklenti
           tarafından [0,1] aralığına kırpılır, hiç yayın olmazsa 0. -->
      <left_throttle_topic>/model/falcon_v2/propulsion/left/throttle_cmd</left_throttle_topic>
      <right_throttle_topic>/model/falcon_v2/propulsion/right/throttle_cmd</right_throttle_topic>
      <!-- Kısıtlanmış gz.msgs.Double_V tanı yayın hızı (Hz),
           /model/falcon_v2/propulsion/diagnostics üzerinde. Alan sırası
           (motor başına 14 alan, önce sol sonra sağ): throttle, current_A,
           Q_motor_Nm, omega_ownframe_rad_s, rpm, J, Ct, Cp, thrust_N,
           Q_prop_Nm, interpClamped, rpmCapActive,
           negativeCurrentClamped, currentLimited. -->
      <diagnostics_rate_hz>20.0</diagnostics_rate_hz>
    </plugin>

    <!-- AKTÜATÖR/SERVO EKLENTİSİ. Zincir: aktüatör komutu, hız sınırlı
         ve efor sınırlı servo dinamiği, ardından gerçek
         gz::sim::Joint::SetForce() torku ile gerçek Gazebo joint hareketi.
         Var olan 5 kontrol yüzeyi joint'ini sürer; linklerini veya
         geometrisini yeniden tanımlamaz. Aerodinamik eklentisi aynı 5
         joint'in GERÇEK konumunu her tick ECM'den okumaya devam eder, onları
         neyin sürdüğünden bağımsız olarak.

         Yüzey başına hareket/hız/efor/kontrol yasası veri kümesi
         config/actuator_v1_config.yaml olup Configure() anında yüklenir; ne
         bu SDF bloğunda ne de C++ kaynağında gömülü katsayı vardır.

         Komut arayüzü: 5 yüzeyin her biri kendi gz.msgs.Double topic'i
         üzerinden fiziksel açı radyanı olarak bağımsız komutlanır. Son
         geçerli komutu tutan bir failsafe vardır ve hiç komut gelmezse
         varsayılan 0 rad'dır (nötr), yani açılışta ani bir sapma olmaz.
         ArduPlane SITL altında bu topic'leri bu dosyanın sonundaki
         ArduPilotPlugin kanalları sürer.

         config_path Gazebo'nun çalışma dizinine göre çözülür; simülasyon
         depo kök dizininden başlatılmalıdır. -->
    <plugin filename="FalconV2Actuators" name="falcon_v2_actuators::ActuatorSystem">
      <config_path>config/actuator_v1_config.yaml</config_path>
      <!-- Yüzey başına komut topic'leri, gz.msgs.Double, fiziksel açı
           radyanı. Eklenti değeri +/-45 dereceye kırpar, içeride hız
           sınırlar, son geçerli komutu tutar ve hiç yayın olmazsa 0 rad
           (nötr) kullanır. Aşağıdaki değerler eklentinin kendi yerleşik
           varsayılanlarıyla aynıdır; keşfedilebilirlik ve üzerine yazma
           kolaylığı için açıkça listelenmiştir. -->
      <left_aileron_cmd_topic>/model/falcon_v2/actuators/left_aileron/cmd_rad</left_aileron_cmd_topic>
      <right_aileron_cmd_topic>/model/falcon_v2/actuators/right_aileron/cmd_rad</right_aileron_cmd_topic>
      <left_elevator_cmd_topic>/model/falcon_v2/actuators/left_elevator/cmd_rad</left_elevator_cmd_topic>
      <right_elevator_cmd_topic>/model/falcon_v2/actuators/right_elevator/cmd_rad</right_elevator_cmd_topic>
      <rudder_cmd_topic>/model/falcon_v2/actuators/rudder/cmd_rad</rudder_cmd_topic>
      <!-- gz.msgs.Double_V tanıları,
           /model/falcon_v2/actuators/diagnostics üzerinde. Alan sırası
           (yüzey başına 7 alan; left_aileron, right_aileron, left_elevator,
           right_elevator, rudder): cmd_rad, target_clamped_rad,
           setpoint_rad, actual_angle_rad, actual_rate_rad_s,
           target_clamp_active, effort_clamp_active. Toplam 35 alan. -->
      <diagnostics_rate_hz>20.0</diagnostics_rate_hz>
    </plugin>

    <!-- RÜZGÂR/HAMLE ÜRETECİ EKLENTİSİ. Yalnızca world çerçevesinde bir
         rüzgâr HIZ vektörü yayınlar. Aerodinamik ve itki eklentilerinin
         abone olduğu /model/falcon_v2/wind topic'inin yayıncısıdır; onlar
         bunu Vrel = Vgövde - Vrüzgâr olarak tüketir. Bu eklenti hiçbir
         linke doğrudan kuvvet veya wrench uygulamaz; plugins/wind/ içinde
         tek bir AddWorldForce/AddWorldWrench çağrısı yoktur. Tek fiziksel
         çıktısı yayınlanan hız vektörüdür, rüzgârın tüm aerodinamik ve
         itkisel etkisi yalnızca o iki eklentideki bağıl akış tüketiminden
         geçer.

         Kural: yayınlanan vektörler HAVA KÜTLESİNİN WORLD ÇERÇEVESİNDEKİ
         HIZIDIR, meteorolojideki "rüzgârın geldiği yön" ifadesi değildir.

         Komut arayüzü: canlı güncellenebilir sabit rüzgâr vektörü
         (steady_cmd_topic) ve tek bir programlanabilir deterministik
         1-kosinüs hamlesi (gust_cmd_topic, sabit 6 alanlı sıra). SINIRLAMA:
         aynı anda yalnızca BİR hamle programlanabilir veya sürebilir; yeni
         bir hamle komutu var olanı geçersiz kılar. -->
    <plugin filename="FalconV2Wind" name="falcon_v2_wind::WindSystem">
      <!-- Açılıştaki sabit rüzgâr bileşeni, world çerçevesi, m/s.
           Varsayılan sıfır vektör: "0 0 0" bırakıldığı ve hiç hamle
           komutlanmadığı sürece yayınlanan rüzgâr, eklenti eklenmeden
           önceki her zaman sıfır davranışıyla bit düzeyinde aynıdır. Yani
           tamamen eklemeli bir özelliktir; eklenti etkin olarak
           komutlanmadıkça daha önce doğrulanmış hiçbir sonuç değişemez.
           steady_cmd_topic ile canlı olarak üzerine yazılabilir. -->
      <steady_wind_mps>0 0 0</steady_wind_mps>
      <!-- gz.msgs.Vector3d topic'i, WORLD çerçevesi, m/s. Aerodinamik ve
           itki eklentilerinin hâlihazırda abone olduğu AYNI topic. Her
           PreUpdate() tick'inde yayınlanır (kısıtlamasız) ve asla doğrudan
           kuvvet olarak uygulanmaz. -->
      <wind_topic>/model/falcon_v2/wind</wind_topic>
      <!-- Canlı sabit rüzgâr komutu, gz.msgs.Vector3d, world çerçevesi,
           m/s. Son geçerli komutu tutan failsafe; sonlu olmayan bileşenler
           reddedilir. -->
      <steady_cmd_topic>/model/falcon_v2/wind/steady_cmd</steady_cmd_topic>
      <!-- Tek deterministik 1-kosinüs hamle komutu, gz.msgs.Double_V,
           SABİT alan sırası:
             [0] dir_x, [1] dir_y, [2] dir_z : ham yön (normalize edilmiş
                 olmak zorunda değil, içeride normalize edilir; dejenere
                 veya sıfıra yakın yön reddedilir)
             [3] amplitude_mps : tepe hamle hızı, m/s (negatif olabilir, bu
                 durumda yön işareti ters çevrilir)
             [4] start_delay_s : BU KOMUTUN ALINDIĞI andan itibaren saniye,
                 mutlak simülasyon zamanı değil
             [5] duration_s : saniye, 0'dan büyük olmalı
           SINIRLAMA: aynı anda yalnızca bir hamle programlanabilir veya
           sürebilir; yeni geçerli bir komut var olanı tümüyle geçersiz
           kılar. -->
      <gust_cmd_topic>/model/falcon_v2/wind/gust_cmd</gust_cmd_topic>
    </plugin>

    <!-- PİTOT (SİMÜLE HIZ) SENSÖRÜ EKLENTİSİ

         DURUM: gerçek Falcon V2 gövdesinde pitot/hava hızı sensörü YOKTU
         (yakalanan gerçek uçak parametrelerinde ARSPD_TYPE=0). Bu eklenti
         yalnızca simülasyona özgü bir eklemedir, etiket
         SIMULATION_ADDED_PITOT_SENSOR; gerçek uçakta uçmuş hiçbir fiziksel
         sensörü temsil etmez.

         NEDEN ÖZEL EKLENTİ, NATIVE gz-sim air_speed <sensor> DEĞİL: tam
         karar kaydı plugins/sensors/PitotModel.hh başlık yorumunda. Kısaca:
         kurulu sdformat air_speed.sdf şartnamesinde rüzgârı tüketen hiçbir
         alan yok ve bu sistemdeki tek native Gazebo rüzgâr mekanizması
         (gz-sim-wind-effects-system) bu projenin
         /model/falcon_v2/wind topic'iyle mimari olarak ilgisizdir.

         Var olan /model/falcon_v2/wind topic'ine abone olur (salt okuma,
         aerodinamik ve itki eklentileriyle aynı kural) ve aerodinamiğe,
         itkiye veya aktüatörlere YENİ bir komut yolu açmaz. Aşağıdaki
         air_density_rho_kg_m3 varsayılanı config/aero_v1_config.yaml
         içindeki environment.air_density_rho_kg_m3 değerinden alınmıştır
         (CONFIRMED, 1.225, ISA deniz seviyesi), burada yeniden
         türetilmemiştir. -->
    <plugin filename="FalconV2Pitot" name="falcon_v2_sensors::PitotSystem">
      <!-- Montaj noktası (m, FLU, base_link orijinine göre). Yukarıdaki 4
           native sensörle aynı belgelenmiş tercihle Gazebo/CAD CG'siyle
           aynı noktada (SIMULATION_ASSUMPTION; gerçek gövdedeki montaj
           konumu DATA_REQUIRED). -->
      <mount_offset_body>0.168309 0 0.100000</mount_offset_body>
      <air_density_rho_kg_m3>1.225</air_density_rho_kg_m3>
      <!-- V1_PROVISIONAL güncelleme hızı. -->
      <update_rate_hz>10.0</update_rate_hz>
      <!-- V1_PROVISIONAL_SENSOR_NOISE, varsayılan olarak KAPALI
           (0.0 = deterministik mod, doğrulanmış varsayılan mod). -->
      <noise_stddev_mps>0.0</noise_stddev_mps>
      <wind_topic>/model/falcon_v2/wind</wind_topic>
      <!-- gz.msgs.Double, m/s. Skaler hava hızı; çerçeveden bağımsız
           Vrel = Vnokta_world - Vrüzgâr_world büyüklüğü. -->
      <airspeed_topic>/model/falcon_v2/sensors/pitot/airspeed_mps</airspeed_topic>
      <!-- gz.msgs.Double, Pa. Standart sıkıştırılamaz dinamik basınç
           q = 0.5 x rho x V^2. -->
      <pressure_topic>/model/falcon_v2/sensors/pitot/differential_pressure_pa</pressure_topic>
    </plugin>

    <!-- MANYETOMETRE SENSÖRÜ EKLENTİSİ (özel; native
         gz-sim-magnetometer-system'in yerini alır)

         NEDEN ÖZEL EKLENTİ: native gz-sim <sensor type="magnetometer"> ile
         world seviyesindeki gz-sim-magnetometer-system ikilisi (yukarıda
         base_link altındaki ilgili yoruma bakın) world'de bildirilen
         <magnetic_field> değerine hiç tepki vermeyen, sabit yaklaşık 0.32
         büyüklüklü bir field_tesla çıktısı yayınlar: 100 katlık ölçek
         testinde oran 1.0000 çıkar. Bu, kurulu gz-sim8/gz-sensors8
         ikililerinde tekrarlanabilir bir kusurdur ve yama uygulanabilecek
         kaynak mevcut değildir. World'ün bildirdiği alan
         gz::sensors::v8::MagnetometerSensor::SetWorldMagneticField()
         fonksiyonuna doğru ulaşır; kusur bunun aşağısında, kurulu ikilinin
         kendi Update()/yayın yolundadır. Tam kanıt zinciri
         plugins/sensors/MagnetometerSystem.hh başlık yorumunda. Bu eklenti
         yukarıdaki FalconV2Pitot ile aynı mimari örüntüyü izler.

         Native sensörün kullandığı AYNI topic'te
         (/model/falcon_v2/sensors/mag) aynı mesaj tipiyle yayınlar
         (gz.msgs.Magnetometer, field_tesla, gövde FLU çerçevesi,
         base_link'e göre sıfır dönüş), böylece hiçbir tüketicinin değişmesi
         gerekmez. Alan hesabı yalnızca oryantasyona dayanır: base_link'in
         world oryantasyonunu ECM'den okur ve aşağıdaki sabit world
         çerçevesi alanını RotateVectorReverse ile gövde çerçevesine
         döndürür; bu, projedeki IMU özgül kuvvet okuması için kullanılan
         kuralın aynısıdır. Kaldıraç kolu veya hız bağımlılığı olmadığı için
         pitottaki mount_offset_body gibi bir montaj noktası parametresine
         burada gerek yoktur. -->
    <plugin filename="FalconV2Magnetometer" name="falcon_v2_sensors::MagnetometerSystem">
      <!-- Sabit Dünya manyetik alan vektörü, WORLD (ENU) çerçevesi,
           Tesla. SIMULATION_ASSUMPTION: bu projenin world dosyasının
           <magnetic_field> ile bildirdiği değerle sayısal olarak aynıdır;
           bu da sdformat'ın kendi belgelenmiş world eleman varsayılanıdır.
           Falcon V2'nin gerçek uçuş konumuna özgü manyetik alan
           DATA_REQUIRED olarak kalır. -->
      <world_magnetic_field_tesla>5.5645e-6 22.8758e-6 -42.3884e-6</world_magnetic_field_tesla>
      <!-- V1_PROVISIONAL güncelleme hızı; yerini aldığı native sensör
           için kullanılan değerle aynıdır. -->
      <update_rate_hz>50.0</update_rate_hz>
      <!-- gz.msgs.Magnetometer, field_tesla (T), gövde FLU çerçevesi. -->
      <topic>/model/falcon_v2/sensors/mag</topic>
    </plugin>

    <!-- ARDUPILOT SITL TAŞIMA EKLENTİSİ (resmî ardupilot_gazebo
         ArduPilotPlugin; bu projenin kendi kodu değil).

         İkili dosya: GZ_SIM_SYSTEM_PLUGIN_PATH üzerindeki bir
         ardupilot_gazebo derlemesinden gelen libArduPilotPlugin.so. Bu
         model, upstream ardupilot_gazebo'da bulunmayan iki eleman kullanır
         (<airspeed_topic> ve <wind_topic>); derlemeden önce
         ardupilot_gazebo kaynağına
         patches/ardupilot_gazebo_airspeed_wind_bridge.patch uygulanmalıdır.
         Aşağıdaki HIZ/RÜZGÂR KÖPRÜSÜ yorumuna bakın.

         KOMUT EŞLEME: aşağıdaki 7 <control> bloğunun tamamı type=COMMAND
         kullanır. ArduPilotPlugin'in ApplyMotorForces() fonksiyonu bunu
         <cmd_topic>'e bir gz.msgs.Double yayınlayıp koşulsuz devam ederek
         ele alır; COMMAND kanalı için
         JointForceCmd/JointVelocityCmd/PID efor yoluna ASLA girmez, yani
         ArduPlane bu joint'lerin hiçbirini kuvvet, hız veya konum PID'i ile
         doğrudan sürmez. Buna rağmen her blokta
         <useForce>0</useForce> açıkça verilir: aksi hâlde eklentinin
         Reset() fonksiyonu bu joint'ler üzerinde sıfır değerli bir
         JointForceCmd bileşeni yine de oluşturur, çünkü useForce eklenti
         kaynağında varsayılan olarak true'dur. Pratikte zararsızdır, ama
         "kontrol yüzeyi ve motor joint'lerimizde asla useForce=1 olmaz"
         kuralı yalnızca sık kullanılan kod yolunda değil, harfiyen geçerli
         olsun diye açıkça kapatılmıştır.

         TAŞIMA: UDP JSON; değerler ArduPilotPlugin'in derlenmiş
         varsayılanlarıyla uyumludur ve varsayılanlar hatalı olduğu için
         değil, keşfedilebilirlik için burada açıkça yinelenir.
         connectionTimeoutMaxCount=10 eklentinin kendi varsayılanıdır.
         lock_step=1, simülasyon ile SITL arasında adım adım deterministik
         senkronizasyon verir ve serbest saat kayması bırakmaz; lock_step=0
         ArduPlane'in duvar saatinin Gazebo fizik adımlarının önüne veya
         gerisine düşmesine izin vererek gereksiz bir belirsizlik kaynağı
         olurdu.

         ÇERÇEVE ÜZERİNE YAZMALARI
         modelXYZToAirplaneXForwardZDown DERLENMİŞ VARSAYILANINDA BIRAKILIR
         (aşağıda üzerine yazılmaz) ve bu, FALCON V2'nin gerçekten FLU olan
         gövde çerçevesi için doğrudur: varsayılan Pose3d(0,0,0,GZ_PI,0,0)
         (gövde X ekseni etrafında saf 180 derece roll) (X ileri, Y sol,
         Z yukarı) üçlüsünü (X ileri, Y sağ, Z aşağı) üçlüsüne, yani tam
         olarak FLU'dan FRD'ye eşler. Eklentinin kendi kullandığı gz-math
         Quaterniond/RotateVector API'siyle doğrudan hesaplanarak
         doğrulanmıştır.

         gazeboXYZToNED ise aşağıda AÇIKÇA ÜZERİNE YAZILIR. Derlenmiş
         varsayılan Pose3d(0,0,0,GZ_PI,0,0) geçerli bir world çerçevesi
         ENU'dan NED'e dönüşümü DEĞİLDİR: yalnızca Gazebo world Y ve Z
         işaretlerini çevirir, Gazebo'nun +X world eksenini ise NED'in
         KUZEY yuvasına eşlenmiş bırakır ve böylece Doğu ile Kuzey'i
         sessizce takas eder. Saf +X world ("Doğu") birim vektörü
         varsayılanla döndürüldüğünde (1,0,0) çıkar, yani saf NED Kuzey
         olarak okunur. Burada kullanılan "0 0 0 180 0 90" üzerine yazması
         aynı yöntemle doğrulanmıştır: saf Gazebo world +X ("Doğu")
         vektörünü saf NED Doğu'ya (0,1,0) ve saf Gazebo world +Y
         ("Kuzey") vektörünü saf NED Kuzey'e (1,0,0) eşler. Bu depodaki her
         world <spherical_coordinates><world_frame_orientation>ENU
         bildirdiği için bu düzeltme modelin yüklendiği her world için
         geçerlidir. -->
    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <!-- Port ayarları. Eklentinin kendi derlenmiş varsayılanına eşit
           olanlar bile bu dosyanın belgeleme kuralına uygun olarak açıkça
           yinelenmiştir (yukarıdaki aerodinamik ve itki bloklarıyla aynı
           yaklaşım). fdm_port_in=9002, ArduPilot'un JSON arka ucundaki
           derlenmiş varsayılan control_port ile aynıdır (ArduPilot
           kaynağında SITL/SIM_JSON.h); varsayılmayıp doğrudan kaynaktan
           okunarak doğrulanmıştır. Bu sayede localhost üzerinde yalın bir
           `-M json` / `-f json` SITL başlatması bu eklentiye bağlanmak için
           adres veya port argümanı gerektirmez. -->
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>10</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>

      <!-- Gövde çerçevesi üzerine yazma: YOK (derlenmiş varsayılan
           korunur). Canlı doğrulanmış gerekçe için yukarıdaki ÇERÇEVE
           ÜZERİNE YAZMALARI yorumuna bakın. -->

      <!-- World çerçevesi üzerine yazma: GEREKLİ ve canlı doğrulanmış.
           Yukarıdaki ÇERÇEVE ÜZERİNE YAZMALARI yorumuna bakın. -->
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>

      <!-- Sensör: yukarıda base_link altına eklenen, ArduPilot köprüsüne
           özel IMU röle sensörünün kapsamlı adı. imu_sensor DEĞİL; neden
           ikinci bir örnek gerektiği için o sensörün kendi yorumuna bakın.

           Ad, "::" ayraçlı ve MODELE GÖRELİ LİNK biçimindedir
           (link::sensör; başta model adı yok). entitiesFromScopedName()
           _relativeTo olarak bu modelin kendi varlığıyla çağrılır ve
           gz::sim::Util.hh'nin belgelenmiş sözleşmesine göre "kapsamlı ad
           [_relativeTo varlığının] adını içermez". Upstream
           zephyr_with_ardupilot örneğindeki 3 parçalı biçim yalnızca o
           model <include> ile ayrı bir alt model İÇ İÇE geçirdiği için
           çalışır; orada "zephyr" relativeTo varlığının kendi adı değil,
           bir ara modeldir. FALCON V2 ise tek ve düz bir
           <model name="falcon_v2"> olduğundan başta "falcon_v2::" öneki
           burada geçerli değildir: hem
           "falcon_v2::base_link::imu_sensor_ardupilot" hem
           "world::falcon_v2::base_link::imu_sensor_ardupilot"
           "imu_sensor [...] not found, abort ArduPilot plugin" hatasıyla
           başarısız olur; aşağıda kullanılan
           "base_link::imu_sensor_ardupilot" ise sorunsuz çözülür.

           Bu köprüden geçen tek sensörler IMU ile aşağıdaki hava
           hızı/rüzgâr köprüsüdür. GPS, barometre ve manyetometre bu köprü
           üzerinden Gazebo sensörlerinden OKUNMAZ; bu, ArduPilot JSON/FDM
           arka ucunun standart davranışıdır, burada üretilmiş bir kusur
           değildir. -->
      <imuName>base_link::imu_sensor_ardupilot</imuName>

      <!-- ArduPlane SITL'E HAVA HIZI / RÜZGÂR KÖPRÜSÜ

           Bu iki eleman olmadan FalconV2Pitot'un çıktısını hiçbir şey
           tüketmez: ArduPlane'in hava hızı YER hızından türetilir ve
           SITL/SIM_JSON.cpp her karede wind_ef değerini sıfırlar.

           Bu iki eleman upstream ardupilot_gazebo ArduPilotPlugin'ine
           FALCON V2 EKLEMESİDİR; derlemeden önce ardupilot_gazebo kaynağına
           patches/ardupilot_gazebo_airspeed_wind_bridge.patch uygulanmalı.
           Eklenen anahtarlar RESMÎ ArduPilot SIM_JSON FDM protokolünün
           hâlihazırda parçası olan iki anahtardır, yani protokol
           uydurulmamıştır:
             "airspeed"      SIM_JSON.h keytable / DataKey::AIRSPEED
             "velocity_wind" SIM_JSON.h keytable / DataKey::WIND_VEL

           BİRİM/ANLAM, airspeed_topic: ArduPilot "airspeed" anahtarını
           gerçek hava hızı değil EŞDEĞER hava hızı (EAS) olarak tüketir.
           SIM_JSON.cpp bu değeri airspeed/airspeed_pitot alanlarına atar;
           SIM_Aircraft.cpp aynı alanları normalde
           velocity_air_ef.length()/eas2tas ile doldurur ve değer sensör
           modeline _update_airspeed(float eas) üzerinden ulaşır.
           FalconV2Pitot ise |V_rel| değerini, bu simülasyondaki her
           aerodinamik kuvvet için config/aero_v1_config.yaml içindeki
           environment.air_density_rho_kg_m3 ile AYNI sabit
           rho = 1.225 kg/m^3 (ISA deniz seviyesi) değerine göre hesaplar.
           Proje genelindeki bu sabit yoğunluk varsayımı altında
           EAS = TAS x sqrt(rho/rho_SSL) = TAS tam olarak sağlanır, yani
           pitotun skaler çıktısı burada yayınlanması gereken doğru EAS
           değeridir. Bu eşitlik, belgelenmiş sabit yoğunluk varsayımının
           bir sonucudur, bağımsız bir iddia değildir.

           BİRİM/ANLAM, wind_topic: gz.msgs.Vector3d, GAZEBO WORLD
           çerçevesi, m/s, HAVA KÜTLESİNİN HIZI. Aerodinamik, itki ve pitot
           eklentilerinin hâlihazırda tükettiği topic ve kuralın aynısı.
           Yeni bir rüzgâr kaynağı ve ikinci bir rüzgâr tüketim yolu
           oluşturulmaz. Eklenti bu vektörü ArduPilot'un NED world
           çerçevesine, araç hızına uygulanan AYNI <gazeboXYZToNED>
           dönüşümüyle döndürür, yani ikinci bir çerçeve kuralı girmez.
           ArduPilot'un wind_ef değeri de aynı hava kütlesi hızı işaret
           kuralını kullanır (velocity_air_ef = velocity_ef - wind_ef).

           FAILSAFE: son geçerli değer tutulur, sonlu olmayan değerler
           reddedilir ve her iki topic'te ilk mesaj gelmeden önce FDM paketi
           upstream ardupilot_gazebo ile bayt düzeyinde aynıdır. -->
      <airspeed_topic>/model/falcon_v2/sensors/pitot/airspeed_mps</airspeed_topic>
      <wind_topic>/model/falcon_v2/wind</wind_topic>

      <!-- SERVO/MOTOR KOMUT EŞLEMESİ. 7 COMMAND tipi kanal (2 aileron,
           2 elevator, 1 rudder, 2 throttle); ArduPlane'in 5 mantıksal
           SERVOx çıkışını bu projenin 7 aktüatör ve itki komut topic'ine
           dağıtır.

           Formül, ArduPilotPlugin'in UpdateMotorCommands() fonksiyonundan
           birebir:
             raw_cmd = clamp((pwm - servo_min) / (servo_max - servo_min), 0, 1)
             cmd     = multiplier * (raw_cmd + offset)

           Aşağıdaki servo_min/servo_max değerleri
           config/ardupilot/falcon_v2_sitl.parm dosyasındaki SERVOx_MIN/MAX
           değerlerinden birebir kopyalanmıştır
           (REAL_PARAM_CONFIGURATION, uydurma değil).

           Açısal (throttle dışı) her kanalda offset=-0.5, PWM = SERVOx_TRIM
           (1500; MIN=800/MAX=2200 için raw_cmd'nin tam orta noktası)
           değerini cmd = 0 rad (nötr) noktasına oturtur ve aktüatör
           eklentisinin kendi 0=nötr kuralıyla örtüşür.

           multiplier = +/-1.5707963268 rad (= +/-pi/2), ArduPlane'in tam
           raw_cmd [0,1] salınımını +/-45 derecelik fiziksel hedef aralığa
           eşler. cmd yalnızca raw_cmd'nin [0,1] aralığında ve offset=-0.5
           ile değerlendirildiği için gerçekleşen çıkış aralığı
           cmd = [-0.5 x multiplier, +0.5 x multiplier] olur, yani
           multiplier'ın kendi değerinin YARISI. Bu yüzden +/-45 derece için
           multiplier = 2 x 45 derecenin radyanı = +/-1.5707963268 rad
           (pi/2) gerekir, +/-0.7853981634 rad DEĞİL; o değer yalnızca
           +/-22.5 derece verirdi. Bu ikameyi yapmayın.

           Bu, config/actuator_v1_config.yaml ile joint <limit>
           elemanlarındaki +/-0.7853981634 rad (+/-45 derece)
           MECHANICAL_ACTUATOR_LIMIT_V1 değerine birebir uyar: köprü,
           ArduPlane'in komut aralığını joint'in mekanik tavanının altına
           yapay olarak kısıtlamaz.

           Her blokta useForce=0; gerekçe için bu eklentinin yukarıdaki
           başlık yorumuna bakın. jointName, COMMAND tipi için biçimsel
           olarak zorunlu ama işlevsel olarak etkisiz bir referanstır
           (ayrıştırılır ve varlığı doğrulanır, asla sürülmez); netlik için
           kanal başına gerçekten ilgili joint yazılmıştır. -->

      <!-- Aileron (SERVO1: FUNCTION=4, MIN=800, MAX=2200, TRIM=1500,
           REVERSED=1; config/ardupilot/falcon_v2_sitl.parm) SOL ailerona.
           Y dağıtımı: tek mantıksal ArduPlane aileron çıkışı her iki
           fiziksel servoyu besler (PROVISIONAL_WIRING_ASSUMPTION).
           multiplier işareti: sol ve sağ ZIT olmalıdır, çünkü doğrulanmış
           eşleme delta_a_aero = +0.5 x (theta_sag - theta_sol) biçimindedir. -->
      <control channel="0">
        <jointName>left_aileron_joint</jointName>
        <useForce>0</useForce>
        <type>COMMAND</type>
        <cmd_topic>/model/falcon_v2/actuators/left_aileron/cmd_rad</cmd_topic>
        <multiplier>1.5707963268</multiplier>
        <offset>-0.5</offset>
        <servo_min>800</servo_min>
        <servo_max>2200</servo_max>
      </control>

      <!-- Aileron (SERVO1) SAĞ ailerona; aynı kanal, ZIT işaret
           (diferansiyel Y dağıtımı). -->
      <control channel="0">
        <jointName>right_aileron_joint</jointName>
        <useForce>0</useForce>
        <type>COMMAND</type>
        <cmd_topic>/model/falcon_v2/actuators/right_aileron/cmd_rad</cmd_topic>
        <multiplier>-1.5707963268</multiplier>
        <offset>-0.5</offset>
        <servo_min>800</servo_min>
        <servo_max>2200</servo_max>
      </control>

      <!-- Elevator (SERVO2: FUNCTION=19, MIN=800, MAX=2200, TRIM=1500,
           REVERSED=0) SOL elevatora. Y dağıtımı aileronla aynı
           PROVISIONAL_WIRING_ASSUMPTION'a dayanır. multiplier işareti:
           aşağıdaki sağ elevator bloğuyla AYNI işaret, çünkü sol ve sağ
           elevator AYNI fiziksel yönde hareket etmelidir; doğrulanmış
           eşleme delta_e_aero = -0.5 x (theta_sol + theta_sag). -->
      <control channel="1">
        <jointName>left_elevator_joint</jointName>
        <useForce>0</useForce>
        <type>COMMAND</type>
        <cmd_topic>/model/falcon_v2/actuators/left_elevator/cmd_rad</cmd_topic>
        <multiplier>1.5707963268</multiplier>
        <offset>-0.5</offset>
        <servo_min>800</servo_min>
        <servo_max>2200</servo_max>
      </control>

      <!-- Elevator (SERVO2) SAĞ elevatora; aynı kanal, solla AYNI işaret
           (ortak modlu pitch, diferansiyel değil). -->
      <control channel="1">
        <jointName>right_elevator_joint</jointName>
        <useForce>0</useForce>
        <type>COMMAND</type>
        <cmd_topic>/model/falcon_v2/actuators/right_elevator/cmd_rad</cmd_topic>
        <multiplier>1.5707963268</multiplier>
        <offset>-0.5</offset>
        <servo_min>800</servo_min>
        <servo_max>2200</servo_max>
      </control>

      <!-- Rudder (SERVO4: FUNCTION=21, MIN=800, MAX=2200, TRIM=1500,
           REVERSED=1) ruddera; tek merkez hattı yüzeyi, dağıtım yok. -->
      <control channel="3">
        <jointName>rudder_joint</jointName>
        <useForce>0</useForce>
        <type>COMMAND</type>
        <cmd_topic>/model/falcon_v2/actuators/rudder/cmd_rad</cmd_topic>
        <multiplier>-1.5707963268</multiplier>
        <offset>-0.5</offset>
        <servo_min>800</servo_min>
        <servo_max>2200</servo_max>
      </control>

      <!-- ThrottleLeft (SERVO3: FUNCTION=73, MIN=1000, MAX=2000,
           TRIM=1000 [= MIN, rölanti düşük; throttle tipi bir fonksiyon için
           standart, hata değil], REVERSED=0) sol motora. multiplier=1 ve
           offset=0 ile cmd doğrudan [0,1] aralığında üretilir ve itki
           eklentisinin OnThrottleLeft içindeki
           std::clamp(msg.data, 0.0, 1.0) tanım kümesiyle birebir örtüşür;
           işaret çevirmesi yok. jointName olarak left_prop_joint yazılıdır
           ve yalnızca COMMAND tipi için zorunlu, etkisiz bir yer
           tutucudur. -->
      <control channel="2">
        <jointName>left_prop_joint</jointName>
        <useForce>0</useForce>
        <type>COMMAND</type>
        <cmd_topic>/model/falcon_v2/propulsion/left/throttle_cmd</cmd_topic>
        <multiplier>1.0</multiplier>
        <offset>0.0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
      </control>

      <!-- ThrottleRight (SERVO5: FUNCTION=74, MIN=1000, MAX=2000,
           TRIM=1000, REVERSED=0) sağ motora; ThrottleLeft'ten bağımsız.
           Çift motor bağımsızlığı baştan sona korunur, hiçbir
           karıştırma veya ortalama yapılmaz. -->
      <control channel="4">
        <jointName>right_prop_joint</jointName>
        <useForce>0</useForce>
        <type>COMMAND</type>
        <cmd_topic>/model/falcon_v2/propulsion/right/throttle_cmd</cmd_topic>
        <multiplier>1.0</multiplier>
        <offset>0.0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
      </control>
    </plugin>

  </model>
</sdf>
