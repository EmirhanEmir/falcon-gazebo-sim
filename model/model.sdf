    <!-- ============================================================
         AERODYNAMICS PLUGIN
         Scope: aerodynamic force/moment physics only - no propulsion and no
         control actuation. This plugin READS the 5 control-surface joint
         positions defined above; it does not command or write them.

         Build: plugins/aerodynamics/ (see plugins/aerodynamics/README.md).
         The structured coefficient dataset is config/aero_v1_config.yaml,
         loaded at Configure() time - no coefficient is hardcoded in this
         SDF block or in the plugin's C++ source.

         config_path is resolved relative to Gazebo's working directory, so
         the simulation must be launched from the repository root. The
         provided launch scripts do this.
         ============================================================ -->
    <plugin filename="FalconV2Aerodynamics" name="falcon_v2_aero::AerodynamicsSystem">
      <config_path>config/aero_v1_config.yaml</config_path>
      <!-- Optional override of the YAML air_density value (kg/m^3). ISA
           sea-level default 1.225, CONFIRMED provenance - see
           aero_v1_config.yaml "environment" block. -->
      <air_density>1.225</air_density>
      <!-- gz.msgs.Vector3d topic, WORLD frame, m/s. Defaults to zero
           wind until the wind plugin (or another publisher) starts
           publishing. -->
      <wind_topic>/model/falcon_v2/wind</wind_topic>
      <!-- Throttled gz.msgs.Double_V diagnostics publish rate (Hz) on
           /model/falcon_v2/aerodynamics/diagnostics. Field order:
           V, alpha_rad, beta_rad, qbar, CL, CD, CY, Cl, Cm, Cn. -->
      <diagnostics_rate_hz>20.0</diagnostics_rate_hz>
    </plugin>

    <!-- ============================================================
         PROPULSION PLUGIN
         Scope: motor/ESC/propeller physics only - no aerodynamic-coefficient
         physics, no control-surface actuation, no ArduPilot/SITL. This
         plugin drives the existing left_prop_joint/right_prop_joint angular
         VELOCITY each tick; it does not redefine them.

         Chain implemented, never bypassed and never collapsed into
         throttle * maximum_thrust: throttle -> ESC/motor electrical ->
         motor torque -> rotor angular dynamics (explicit-Euler state,
         plugin-owned, integrated every tick) -> RPM -> advance ratio J ->
         real APC Ct(J,RPM)/Cp(J,RPM) -> thrust + propeller aerodynamic
         torque -> reaction torque -> force/moment applied to base_link at
         the real hub (left_hub/right_hub, never at the CG). The same omega
         state drives the propeller joints' angular velocity, so the visual
         spin can never diverge from the physics RPM actually producing the
         forces and torques.

         Build: plugins/propulsion/ (see plugins/propulsion/README.md). The
         structured dataset is config/propulsion_v1_config.yaml, loaded at
         Configure() time - no coefficient is hardcoded in this SDF block or
         in the plugin's C++ source. Real APC 13x6.5E Ct(J)/Cp(J) data:
         config/propulsion_data/apc_13x65e_parsed.csv, mechanically parsed
         from the official APC performance-data file PER3_13x65E.dat (see
         config/propulsion_data/PROVENANCE.md).

         Throttle interface: each motor is commanded independently via a
         gz.msgs.Double topic, clamped to [0,1], defaulting to 0 if never
         commanded. Under ArduPlane SITL these topics are driven by the
         ArduPilotPlugin control channels defined near the end of this file.

         config_path is resolved relative to Gazebo's working directory, so
         the simulation must be launched from the repository root.
         ============================================================ -->
    <plugin filename="FalconV2Propulsion" name="falcon_v2_propulsion::PropulsionSystem">
      <config_path>config/propulsion_v1_config.yaml</config_path>
      <!-- Optional override of the YAML rho_kg_m3 value (kg/m^3). ISA
           sea-level default 1.225, CONFIRMED provenance - see
           propulsion_v1_config.yaml "physics" block. -->
      <air_density>1.225</air_density>
      <!-- gz.msgs.Vector3d topic, WORLD frame, m/s - same topic the
           aerodynamics plugin subscribes to (read-only here), used for
           relative-airflow V_axial at each motor's hub. Zero until a
           publisher exists. -->
      <wind_topic>/model/falcon_v2/wind</wind_topic>
      <!-- Per-motor throttle command topics, gz.msgs.Double, value clamped
           to [0,1] by the plugin, default 0 if never published. -->
      <left_throttle_topic>/model/falcon_v2/propulsion/left/throttle_cmd</left_throttle_topic>
      <right_throttle_topic>/model/falcon_v2/propulsion/right/throttle_cmd</right_throttle_topic>
      <!-- Throttled gz.msgs.Double_V diagnostics publish rate (Hz) on
           /model/falcon_v2/propulsion/diagnostics. Field order (14 fields
           per motor, left then right): throttle, current_A, Q_motor_Nm,
           omega_ownframe_rad_s, rpm, J, Ct, Cp, thrust_N, Q_prop_Nm,
           interpClamped, rpmCapActive, negativeCurrentClamped,
           currentLimited. -->
      <diagnostics_rate_hz>20.0</diagnostics_rate_hz>
    </plugin>

    <!-- ============================================================
         ACTUATOR/SERVO PLUGIN
         Scope: the physical actuator/servo command chain only - actuator
         command -> rate-limited, effort-bounded servo dynamics -> real
         Gazebo joint motion via genuine gz::sim::Joint::SetForce() torque.
         No aerodynamic-coefficient physics, no motor/propulsion physics,
         and no ArduPlane/MAVLink/SITL/TECS logic: this plugin ends at the
         physical actuator interface. It drives the 5 existing
         control-surface joints; it does not redefine their link or
         geometry. AerodynamicsSystem.cc continues to read those same 5
         joints' ACTUAL positions from the ECM every tick, regardless of
         what drives them.

         Build: plugins/actuators/ (see plugins/actuators/README.md). The
         structured per-surface travel/rate/effort/control-law dataset is
         config/actuator_v1_config.yaml, loaded at Configure() time - no
         coefficient is hardcoded in this SDF block or in the plugin's C++
         source.

         Command interface: each of the 5 surfaces is commanded
         independently via its own gz.msgs.Double topic in physical-angle
         radians, with a hold-last-valid-command failsafe, defaulting to
         0 rad (neutral) if never commanded - no startup kick. Under
         ArduPlane SITL these topics are driven by the ArduPilotPlugin
         control channels defined near the end of this file.

         config_path is resolved relative to Gazebo's working directory, so
         the simulation must be launched from the repository root.
         ============================================================ -->
    <plugin filename="FalconV2Actuators" name="falcon_v2_actuators::ActuatorSystem">
      <config_path>config/actuator_v1_config.yaml</config_path>
      <!-- Per-surface command topics, gz.msgs.Double, physical-angle-radians,
           clamped to +/-45 deg by the plugin, rate-limited internally,
           hold-last-valid-command failsafe, default 0 rad (neutral) if
           never published. Values below match this plugin's own built-in
           defaults - listed explicitly here for documentation/
           discoverability/override, same convention as the propulsion
           plugin block above's left_throttle_topic/right_throttle_topic. -->
      <left_aileron_cmd_topic>/model/falcon_v2/actuators/left_aileron/cmd_rad</left_aileron_cmd_topic>
      <right_aileron_cmd_topic>/model/falcon_v2/actuators/right_aileron/cmd_rad</right_aileron_cmd_topic>
      <left_elevator_cmd_topic>/model/falcon_v2/actuators/left_elevator/cmd_rad</left_elevator_cmd_topic>
      <right_elevator_cmd_topic>/model/falcon_v2/actuators/right_elevator/cmd_rad</right_elevator_cmd_topic>
      <rudder_cmd_topic>/model/falcon_v2/actuators/rudder/cmd_rad</rudder_cmd_topic>
      <!-- gz.msgs.Double_V diagnostics on
           /model/falcon_v2/actuators/diagnostics. Field order (7 fields per
           surface, left_aileron/right_aileron/left_elevator/
           right_elevator/rudder): cmd_rad, target_clamped_rad, setpoint_rad,
           actual_angle_rad, actual_rate_rad_s, target_clamp_active,
           effort_clamp_active - 35 fields total. -->
      <diagnostics_rate_hz>20.0</diagnostics_rate_hz>
    </plugin>

    <!-- ============================================================
         WIND/GUST GENERATOR PLUGIN
         Scope: publishes a world-frame wind VELOCITY vector only. It is the
         publisher for the /model/falcon_v2/wind topic that
         AerodynamicsSystem.cc and PropulsionSystem.cc subscribe to and
         consume as Vrel = Vbody - Vwind. This plugin NEVER applies a direct
         force or wrench to any link - no AddWorldForce/AddWorldWrench call
         exists anywhere in plugins/wind/. Its only physical output is the
         published velocity vector; all aerodynamic and propulsive effect of
         wind flows exclusively through the relative-airflow consumption in
         the two plugins named above.

         Build: plugins/wind/ (see plugins/wind/README.md).

         Convention: published vectors are the WORLD-FRAME VELOCITY OF THE
         AIR MASS, not the meteorological "wind coming from" phrasing.

         Command interface: a live-updatable steady-wind vector
         (steady_cmd_topic) plus a single schedulable deterministic
         1-cosine gust (gust_cmd_topic, fixed 6-field order). V1 LIMITATION:
         only ONE gust may be scheduled or in progress at a time - a new
         gust command replaces any existing one.
         ============================================================ -->
    <plugin filename="FalconV2Wind" name="falcon_v2_wind::WindSystem">
      <!-- Constant wind component at startup, world frame, m/s. Default
           zero vector: with this left at "0 0 0" and no gust ever
           commanded, the published wind is bit-identical to the prior
           always-zero behavior (WIND.md sec 8) - purely additive, no
           existing validated result can change unless this plugin is
           actively commanded. Live-overwritable via steady_cmd_topic
           below. -->
      <steady_wind_mps>0 0 0</steady_wind_mps>
      <!-- gz.msgs.Vector3d topic, WORLD frame, m/s - the SAME pre-existing
           topic plugins/aerodynamics/AerodynamicsSystem.cc and
           plugins/propulsion/PropulsionSystem.cc already subscribe to.
           Published every PreUpdate() tick (unthrottled), never as a
           direct force. -->
      <wind_topic>/model/falcon_v2/wind</wind_topic>
      <!-- Live steady-wind command, gz.msgs.Vector3d, world frame, m/s.
           Hold-last-valid-command failsafe; non-finite components
           rejected. -->
      <steady_cmd_topic>/model/falcon_v2/wind/steady_cmd</steady_cmd_topic>
      <!-- Single deterministic 1-cosine gust command, gz.msgs.Double_V,
           FIXED field order:
             [0] dir_x, [1] dir_y, [2] dir_z   - raw direction (need not be
                 pre-normalized; normalized internally; degenerate/near-
                 zero direction rejected)
             [3] amplitude_mps                 - peak gust speed, m/s (may
                 be negative, flips sense relative to dir_x/y/z)
             [4] start_delay_s                 - seconds from THIS
                 COMMAND'S RECEIPT (not absolute sim time) - see WIND.md
                 sec 7 for the exact reference-time mechanism/rationale
             [5] duration_s                    - seconds, must be > 0
           V1 LIMITATION: only one gust may be scheduled/in-progress at a
           time - a new valid command replaces any existing one outright
           (WIND.md sec 5). -->
      <gust_cmd_topic>/model/falcon_v2/wind/gust_cmd</gust_cmd_topic>
    </plugin>

    <!-- ============================================================
         PITOT (SIMULATED AIRSPEED) SENSOR PLUGIN

         STATUS: the real Falcon V2 airframe had NO pitot/airspeed sensor
         installed (ARSPD_TYPE=0 in the captured real-aircraft parameters).
         This plugin is a simulation-only addition, tagged
         SIMULATION_ADDED_PITOT_SENSOR - it does not represent any physical
         sensor that has flown on the real aircraft.

         WHY A CUSTOM PLUGIN, NOT THE NATIVE gz-sim air_speed <sensor>: see
         the plugins/sensors/PitotModel.hh header comment for the full
         decision record. In short, the installed sdformat air_speed.sdf
         sensor spec has no wind-consuming field at all, and the only native
         Gazebo wind mechanism on this system (gz-sim-wind-effects-system)
         is architecturally unrelated to this project's
         /model/falcon_v2/wind topic.

         Subscribes to the existing /model/falcon_v2/wind topic (read-only,
         same convention as AerodynamicsSystem.cc and PropulsionSystem.cc)
         and creates NO new command path into aerodynamics, propulsion or
         actuators. The air_density_rho_kg_m3 default below is cited from
         config/aero_v1_config.yaml environment.air_density_rho_kg_m3
         (CONFIRMED, 1.225, ISA sea-level), not re-derived here.
         ============================================================ -->
    <plugin filename="FalconV2Pitot" name="falcon_v2_sensors::PitotSystem">
      <!-- Mount point (m, FLU, relative to base_link origin) - co-located
           with the Gazebo/CAD CG per the same documented choice as the 4
           native sensors above (SIMULATION_ASSUMPTION, mount location
           DATA_REQUIRED for the real airframe). -->
      <mount_offset_body>0.168309 0 0.100000</mount_offset_body>
      <air_density_rho_kg_m3>1.225</air_density_rho_kg_m3>
      <!-- V1_PROVISIONAL update rate - see SENSORS.md sec 6. -->
      <update_rate_hz>10.0</update_rate_hz>
      <!-- V1_PROVISIONAL_SENSOR_NOISE - OFF by default (0.0 = deterministic
           mode, the default/validated mode). -->
      <noise_stddev_mps>0.0</noise_stddev_mps>
      <wind_topic>/model/falcon_v2/wind</wind_topic>
      <!-- gz.msgs.Double, m/s - scalar airspeed (frame-invariant
           magnitude of Vrel = Vpoint_world - Vwind_world). -->
      <airspeed_topic>/model/falcon_v2/sensors/pitot/airspeed_mps</airspeed_topic>
      <!-- gz.msgs.Double, Pa - standard incompressible dynamic pressure
           q = 0.5*rho*V^2 (see PitotModel.hh). -->
      <pressure_topic>/model/falcon_v2/sensors/pitot/differential_pressure_pa</pressure_topic>
    </plugin>

    <!-- ============================================================
         MAGNETOMETER SENSOR PLUGIN (custom - replaces the native
         gz-sim-magnetometer-system)

         WHY A CUSTOM PLUGIN: the native gz-sim
         <sensor type="magnetometer"> plus world-level
         gz-sim-magnetometer-system pairing (see the removed-sensor comment
         under base_link above) publishes a constant ~0.32-magnitude
         field_tesla output that does NOT respond to the declared world
         <magnetic_field> value at all (ratio 1.0000 under a 100x scale
         test) - a reproducible defect in the installed gz-sim8/gz-sensors8
         binaries, with no source available to patch. The world's declared
         field does reach
         gz::sensors::v8::MagnetometerSensor::SetWorldMagneticField()
         correctly; the defect is downstream of that, inside the installed
         binary's own Update()/publish path. See the
         plugins/sensors/MagnetometerSystem.hh header comment for the full
         evidence trail. This plugin follows the same architectural
         precedent as FalconV2Pitot above.

         Publishes on the SAME topic the native sensor used
         (/model/falcon_v2/sensors/mag) with the same message type
         (gz.msgs.Magnetometer, field_tesla, body FLU frame, zero relative
         rotation to base_link), so no downstream consumer needs to change.
         The field computation is orientation-only: it reads base_link's own
         world orientation from the ECM and rotates the fixed world-frame
         field below into body frame via RotateVectorReverse, the same
         convention used for this project's IMU specific-force reading. It
         has no lever-arm or velocity dependence, so unlike the pitot's
         mount_offset_body no mount-point parameter is needed here.
         ============================================================ -->
    <plugin filename="FalconV2Magnetometer" name="falcon_v2_sensors::MagnetometerSystem">
      <!-- Fixed Earth magnetic field vector, WORLD (ENU) frame, Tesla.
           SIMULATION_ASSUMPTION: identical numeric value to what this
           project's world file already declared via <magnetic_field>
           (sdformat's own documented world-element default,
           /usr/share/sdformat14/1.11/world.sdf) - see SENSORS.md sec 4.4.
           The real Falcon V2 flight-location-specific magnetic field
           remains DATA_REQUIRED. -->
      <world_magnetic_field_tesla>5.5645e-6 22.8758e-6 -42.3884e-6</world_magnetic_field_tesla>
      <!-- V1_PROVISIONAL update rate - matches the value already
           documented/used for the (now-replaced) native sensor, see
           SENSORS.md sec 6. -->
      <update_rate_hz>50.0</update_rate_hz>
      <!-- gz.msgs.Magnetometer, field_tesla (T), body FLU frame. -->
      <topic>/model/falcon_v2/sensors/mag</topic>
    </plugin>

    <!-- ============================================================
         ARDUPILOT SITL TRANSPORT PLUGIN (the official ardupilot_gazebo
         ArduPilotPlugin - not this project's own code).

         Binary: libArduPilotPlugin.so from an ardupilot_gazebo build on
         GZ_SIM_SYSTEM_PLUGIN_PATH. This model uses two elements
         (<airspeed_topic>, <wind_topic>) that upstream ardupilot_gazebo
         does not provide; apply patches/ardupilot_gazebo_airspeed_wind_
         bridge.patch to the ardupilot_gazebo source before building it.
         See the AIRSPEED/WIND BRIDGE comment below.

         SCOPE: transport and command mapping only. All 7 <control> blocks
         below use type=COMMAND, which ArduPilotPlugin's ApplyMotorForces()
         handles by publishing a gz.msgs.Double to <cmd_topic> and then
         unconditionally continuing - it NEVER reaches the
         JointForceCmd/JointVelocityCmd/PID-effort code path for a COMMAND
         channel, so ArduPlane never drives any of these joints directly via
         force, velocity or position PID. <useForce>0</useForce> is set
         explicitly on every block anyway as defence in depth: without it,
         ArduPilotPlugin's Reset() would still create a zero-initialised
         JointForceCmd component on these joints, since useForce defaults to
         true in the plugin's source. Harmless in practice, but disabled
         explicitly so the "never useForce=1 on our control-surface or motor
         joints" rule holds literally, not just on the common code path.

         TRANSPORT: UDP JSON, matching ArduPilotPlugin's compiled defaults
         (restated explicitly here for discoverability, not because the
         defaults were wrong). connectionTimeoutMaxCount=10 is the plugin's
         own default. lock_step=1 gives deterministic step-for-step
         sim<->SITL synchronisation with no free-running clock drift;
         lock_step=0 would let ArduPlane's wall clock run ahead of or behind
         Gazebo's physics steps, an unnecessary source of nondeterminism.

         FRAME OVERRIDES:
         modelXYZToAirplaneXForwardZDown is LEFT AT ITS COMPILED DEFAULT (no
         override below) - correct for FALCON V2's genuinely FLU body frame:
         the default Pose3d(0,0,0,GZ_PI,0,0) (pure 180 deg roll about body
         X) maps (X-fwd, Y-left, Z-up) -> (X-fwd, Y-right, Z-down), i.e.
         FLU -> FRD exactly. Verified by direct computation with the same
         gz-math7 Quaterniond/RotateVector API the plugin itself uses.

         gazeboXYZToNED IS EXPLICITLY OVERRIDDEN below. The compiled default
         Pose3d(0,0,0,GZ_PI,0,0) is NOT a correct world-frame ENU->NED
         conversion: it only flips Gazebo world Y/Z sign while leaving
         Gazebo's +X-world axis mapped into NED's NORTH slot, silently
         swapping East and North. Rotating a pure +X-world ("East") unit
         vector by the default yields (1,0,0), i.e. it reads out as pure
         NED-North rather than NED-East. The override used here,
         "0 0 0 180 0 90", was verified with the identical method to map a
         pure Gazebo-world +X ("East") vector to pure NED-East (0,1,0) and a
         pure Gazebo-world +Y ("North") vector to pure NED-North (1,0,0).
         Every world in this repository declares
         <spherical_coordinates><world_frame_orientation>ENU</...>, so this
         correction applies to every world this model is loaded into. -->
    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <!-- Port settings - all restated explicitly even where they equal
           the plugin's own compiled default, per this project's existing
           documentation convention (see aerodynamics/propulsion plugin
           blocks above). fdm_port_in=9002 matches ArduPilot's own JSON
           backend compiled default control_port (SIM_JSON.h,
           /home/emirhan/gazebo_sim/ardupilot/libraries/SITL/SIM_JSON.h
           line 63) - confirmed by direct source read, not assumed: a bare
           `-M json` / `-f json` SITL launch on localhost requires no
           address/port arguments to connect to this plugin. -->
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>10</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>

      <!-- Body-frame override: NONE (compiled default retained). See the
           FRAME OVERRIDES header comment above for the live-verified
           reasoning. -->

      <!-- World-frame override: REQUIRED, live-verified - see the FRAME
           OVERRIDES header comment above. -->
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>

      <!-- Sensors: scoped name of the dedicated ArduPilot-bridge IMU relay
           sensor added above under base_link - NOT imu_sensor; see that
           sensor block's own header comment for why a second instance is
           required.

           The name uses the "::"-delimited, LINK-RELATIVE-TO-MODEL form
           (link::sensor, with no leading model name).
           entitiesFromScopedName() is called with _relativeTo set to this
           model's own entity, and per gz::sim::Util.hh's documented
           contract "The scoped name does not include the name of
           [_relativeTo entity]". The 3-segment form seen in the upstream
           zephyr_with_ardupilot example only works because that model
           NESTS a separate sub-model via <include>, so "zephyr" there is an
           intermediate model rather than the relativeTo entity's own name.
           FALCON V2 is a single flat <model name="falcon_v2">, so a leading
           "falcon_v2::" prefix is not valid here: both
           "falcon_v2::base_link::imu_sensor_ardupilot" and
           "world::falcon_v2::base_link::imu_sensor_ardupilot" fail with
           "imu_sensor [...] not found, abort ArduPilot plugin", while
           "base_link::imu_sensor_ardupilot" (used below) resolves cleanly.

           The IMU and the airspeed/wind bridge below are the only sensors
           in the loop through this plugin. GPS, barometer and magnetometer
           are NOT read from this project's Gazebo sensors through this
           bridge - that is standard ArduPilot JSON/FDM-backend behaviour,
           not a defect introduced here. -->
      <imuName>base_link::imu_sensor_ardupilot</imuName>

      <!-- ============================================================
           AIRSPEED / WIND BRIDGE INTO ArduPlane SITL

           Without these two elements nothing consumes FalconV2Pitot's
           output: ArduPlane's airspeed would be derived from GROUND
           velocity, and SITL/SIM_JSON.cpp would zero wind_ef on every
           frame.

           These two elements are a FALCON V2 ADDITION to the upstream
           ardupilot_gazebo ArduPilotPlugin - apply
           patches/ardupilot_gazebo_airspeed_wind_bridge.patch to the
           ardupilot_gazebo source before building it. They populate two
           keys that are already part of the OFFICIAL ArduPilot SIM_JSON FDM
           protocol, so no protocol extension is invented:
             "airspeed"      SIM_JSON.h keytable / DataKey::AIRSPEED
             "velocity_wind" SIM_JSON.h keytable / DataKey::WIND_VEL

           UNITS/SEMANTICS - airspeed_topic: ArduPilot consumes the
           "airspeed" key as EQUIVALENT airspeed (EAS), not true airspeed.
           SIM_JSON.cpp assigns it to airspeed/airspeed_pitot, which
           SIM_Aircraft.cpp otherwise fills as
           velocity_air_ef.length()/eas2tas and which reaches the sensor
           model via _update_airspeed(float eas). FalconV2Pitot publishes
           |V_rel| computed against the SAME fixed rho = 1.225 kg/m^3 (ISA
           sea level) that config/aero_v1_config.yaml
           environment.air_density_rho_kg_m3 uses for every aerodynamic
           force in this simulation. Under that project-wide
           constant-density assumption EAS = TAS * sqrt(rho/rho_SSL) = TAS
           exactly, so the pitot's scalar output IS the correct EAS to
           publish here. This equality is a consequence of the documented
           constant-density assumption, not an independent claim.

           UNITS/SEMANTICS - wind_topic: gz.msgs.Vector3d, GAZEBO WORLD
           frame, m/s, VELOCITY OF THE AIR MASS - the same topic and same
           convention that AerodynamicsSystem.cc, PropulsionSystem.cc and
           PitotSystem.cc already consume. No new wind source and no second
           wind-consumption path is created. The plugin rotates it into
           ArduPilot's NED world frame using the SAME <gazeboXYZToNED>
           transform already applied to the vehicle velocity, so no second
           frame convention is introduced. ArduPilot's wind_ef uses the
           identical airmass-velocity sign convention
           (velocity_air_ef = velocity_ef - wind_ef).

           FAILSAFE: hold-last-valid; non-finite values are rejected; before
           the first message on either topic the FDM packet is byte-
           identical to upstream ardupilot_gazebo. ============ -->
      <airspeed_topic>/model/falcon_v2/sensors/pitot/airspeed_mps</airspeed_topic>
      <wind_topic>/model/falcon_v2/wind</wind_topic>

      <!-- ============================================================
           SERVO/MOTOR COMMAND MAPPING - 7 COMMAND-type channels (2 aileron
           + 2 elevator + 1 rudder + 2 throttle), fanning out ArduPlane's 5
           logical SERVOx outputs onto this project's 7 actuator and
           propulsion command topics.

           Formula, exact from ArduPilotPlugin's UpdateMotorCommands():
             raw_cmd = clamp((pwm - servo_min) / (servo_max - servo_min), 0, 1)
             cmd     = multiplier * (raw_cmd + offset)

           servo_min/servo_max below are copied exactly from the
           SERVOx_MIN/MAX values in config/ardupilot/falcon_v2_sitl.parm
           (REAL_PARAM_CONFIGURATION, not invented).

           offset=-0.5 on every angular (non-throttle) channel centres
           PWM = SERVOx_TRIM (1500, the exact raw_cmd midpoint for
           MIN=800/MAX=2200) at cmd = 0 rad (neutral), matching
           ActuatorSystem.cc's own 0=neutral convention.

           multiplier = +/-1.5707963268 rad (= +/-pi/2) maps ArduPlane's
           full raw_cmd [0,1] swing onto a +/-45 deg physical target range.
           Because cmd is only ever evaluated at raw_cmd in [0,1] with
           offset=-0.5, the realised output range is
           cmd in [-0.5*multiplier, +0.5*multiplier], i.e. HALF the
           multiplier's own value. +/-45 deg therefore requires
           multiplier = 2 * 45deg-in-radians = +/-1.5707963268 rad (pi/2),
           NOT +/-0.7853981634 rad - that would realise only +/-22.5 deg.
           Do not make this substitution.

           This matches config/actuator_v1_config.yaml's own
           +/-0.7853981634 rad (+/-45 deg) MECHANICAL_ACTUATOR_LIMIT_V1
           joint <limit> exactly: the bridge does not artificially restrict
           ArduPlane's commanded range below the joint's mechanical ceiling.

           useForce=0 on every block - see this plugin's header comment
           above. jointName is a formally required but functionally inert
           reference for COMMAND type (parsed and validated to exist, never
           actually driven); the actually-relevant joint per channel is used
           for clarity. ============================================== -->

      <!-- Aileron (SERVO1: FUNCTION=4, MIN=800, MAX=2200, TRIM=1500,
           REVERSED=1 - config/ardupilot/falcon_v2_sitl.parm) -> LEFT
           aileron. Y-split fan-out (PROVISIONAL_WIRING_ASSUMPTION, one
           logical ArduPlane Aileron output feeds both physical servos -
           SITL_PARAM_MIGRATION.md sec 2/14). multiplier sign: see design
           doc sec 3 (left/right must be OPPOSITE per the verified
           delta_a_aero = +0.5*(theta_right-theta_left) mapping,
           CONTROLS.md sec 10). -->
      <control channel="0">
        <jointName>left_aileron_joint</jointName>
        <useForce>0</useForce>
        <type>COMMAND</type>
        <cmd_topic>/model/falcon_v2/actuators/left_aileron/cmd_rad</cmd_topic>
        <multiplier>1.5707963268</multiplier>
        <offset>-0.5</offset>
        <servo_min>800</servo_min>
        <servo_max>2200</servo_max>
      </control>

      <!-- Aileron (SERVO1) -> RIGHT aileron, same channel, OPPOSITE sign
           (differential Y-split - see design doc sec 3). -->
      <control channel="0">
        <jointName>right_aileron_joint</jointName>
        <useForce>0</useForce>
        <type>COMMAND</type>
        <cmd_topic>/model/falcon_v2/actuators/right_aileron/cmd_rad</cmd_topic>
        <multiplier>-1.5707963268</multiplier>
        <offset>-0.5</offset>
        <servo_min>800</servo_min>
        <servo_max>2200</servo_max>
      </control>

      <!-- Elevator (SERVO2: FUNCTION=19, MIN=800, MAX=2200, TRIM=1500,
           REVERSED=0) -> LEFT elevator. Y-split fan-out (same
           PROVISIONAL_WIRING_ASSUMPTION as aileron). multiplier sign: SAME
           sign as the right-elevator block below (left/right elevator
           must move in the SAME physical direction - verified
           delta_e_aero = -0.5*(theta_left+theta_right) mapping,
           CONTROLS.md sec 10). -->
      <control channel="1">
        <jointName>left_elevator_joint</jointName>
        <useForce>0</useForce>
        <type>COMMAND</type>
        <cmd_topic>/model/falcon_v2/actuators/left_elevator/cmd_rad</cmd_topic>
        <multiplier>1.5707963268</multiplier>
        <offset>-0.5</offset>
        <servo_min>800</servo_min>
        <servo_max>2200</servo_max>
      </control>

      <!-- Elevator (SERVO2) -> RIGHT elevator, same channel, SAME sign as
           left (common-mode pitch, not differential - see design doc). -->
      <control channel="1">
        <jointName>right_elevator_joint</jointName>
        <useForce>0</useForce>
        <type>COMMAND</type>
        <cmd_topic>/model/falcon_v2/actuators/right_elevator/cmd_rad</cmd_topic>
        <multiplier>1.5707963268</multiplier>
        <offset>-0.5</offset>
        <servo_min>800</servo_min>
        <servo_max>2200</servo_max>
      </control>

      <!-- Rudder (SERVO4: FUNCTION=21, MIN=800, MAX=2200, TRIM=1500,
           REVERSED=1) -> rudder (single centerline surface, no split). -->
      <control channel="3">
        <jointName>rudder_joint</jointName>
        <useForce>0</useForce>
        <type>COMMAND</type>
        <cmd_topic>/model/falcon_v2/actuators/rudder/cmd_rad</cmd_topic>
        <multiplier>-1.5707963268</multiplier>
        <offset>-0.5</offset>
        <servo_min>800</servo_min>
        <servo_max>2200</servo_max>
      </control>

      <!-- ThrottleLeft (SERVO3: FUNCTION=73, MIN=1000, MAX=2000,
           TRIM=1000 [==MIN, idle-low, standard for a throttle-type
           function, not a bug], REVERSED=0) -> left motor. multiplier=1,
           offset=0 gives cmd directly in [0,1], matching
           plugins/propulsion/PropulsionSystem.cc's OnThrottleLeft
           std::clamp(msg.data,0.0,1.0) domain exactly - 1:1, no sign flip. jointName points at left_prop_joint (an inert placeholder,
           required only for COMMAND type - see header comment). -->
      <control channel="2">
        <jointName>left_prop_joint</jointName>
        <useForce>0</useForce>
        <type>COMMAND</type>
        <cmd_topic>/model/falcon_v2/propulsion/left/throttle_cmd</cmd_topic>
        <multiplier>1.0</multiplier>
        <offset>0.0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
      </control>

      <!-- ThrottleRight (SERVO5: FUNCTION=74, MIN=1000, MAX=2000,
           TRIM=1000, REVERSED=0) -> right motor, independent of
           ThrottleLeft (twin-motor independence preserved end-to-end, no
           mixing/averaging - SITL_PARAM_MIGRATION.md sec 14). -->
      <control channel="4">
        <jointName>right_prop_joint</jointName>
        <useForce>0</useForce>
        <type>COMMAND</type>
        <cmd_topic>/model/falcon_v2/propulsion/right/throttle_cmd</cmd_topic>
        <multiplier>1.0</multiplier>
        <offset>0.0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
      </control>
    </plugin>

  </model>
</sdf>
