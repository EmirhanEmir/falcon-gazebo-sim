<?xml version="1.0" ?>
<sdf version="1.9">
  <!--
    FALCON V2 - Gazebo Sim Harmonic uçak modeli: sabit kanat,
    konvansiyonel kuyruk, çift motor. 8 link, 7 joint, 5 kontrol yüzeyi.

    Koordinat çerçevesi: baştan sona Gazebo/CAD FLU gövde çerçevesi
    (+X ileri, +Y sol, +Z yukarı). Hiçbir XFLR5 çerçevesi değeri
    kullanılmaz.

    Toplam kütle 6.000 kg = base_link 5.9348 kg + 2 x 0.0301 kg pervane
    + 5 x 0.001 kg hareketli kontrol yüzeyi.

    Mesh ölçeği STL_SCALE_TO_SI = 0.001 (mm'den m'ye); 12 STL ortak global
    montaj koordinat sistemini paylaşır, hiçbiri yeniden merkezlenmemiştir.
  -->

  <model name="falcon_v2">
    <static>false</static>
    <self_collide>false</self_collide>
    <pose>0 0 0 0 0 0</pose>

    <!-- BASE LINK: sabit yapı. Gövde, iki kanat ve iki motor naseli
         (yalnızca görsel). Toplam uçak kütlesinden 7 hareketli alt link
         çıkarıldıktan sonra kalan kütleyi, Gazebo/CAD CG'sini ve
         V1_PROVISIONAL tüm uçak atalet tensörünü taşır. -->
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <!--
          CG: Gazebo/CAD referans CG'si (0.168309, 0, 0.100000) m,
          CONFIRMED. Bu dosyada kullanılan TEK CG budur. XFLR5 referans
          CG'si (0.0637, 0, -0.0210) SDF amaçlı asla kullanılmaz; iki değer
          farklı referans tanımlarına dayanır ve biri diğerinin yerine
          konulamaz.
          Kütle: 5.9348 kg = 6.000 kg toplam eksi 7 hareketli alt linkteki
          0.0652 kg. Bilinen hiçbir bileşen kütlesi iki kez sayılmaz: motor
          kütlesi (toplam 0.286 kg) base_link içinde kalır, çünkü motorlar
          ayrı link değil sabit görsellerdir; pervane kütlesi (toplam
          0.0602 kg) base_link'ten tam bir kez düşülmüştür.
          Atalet: Gazebo/CAD CG'si etrafında V1_PROVISIONAL tüm uçak
          tensörü.
          Ixz işaret kuralının SDF'nin beklediği köşe dışı işaretle uyumu
          AÇIKÇA DOĞRULANMAMIŞTIR: değer belgelendiği biçimiyle (+0.01485)
          girilmiş ve sessizce "düzeltilmek" yerine bilinçli olarak
          işaretli bırakılmıştır.
        -->
        <pose>0.168309 0 0.100000 0 0 0</pose>
        <mass>5.9348</mass>
        <inertia>
          <ixx>0.7284</ixx>
          <iyy>0.2507</iyy>
          <izz>0.9523</izz>
          <ixy>0</ixy>
          <ixz>0.01485</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- Sabit görseller: mesh kendi ham global/montaj koordinatlarında
           kullanılır. Link orijini = model orijini = (0,0,0); yalnızca
           STL_SCALE_TO_SI = 0.001 ölçeği uygulanır, ek bir görsel pose
           kaydırması yoktur. Mesh, sabit parçaların doğru mutlak konumunu
           zaten kendisi taşıdığı için buna gerek kalmaz. -->
      <visual name="body_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/body.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.28 0.30 0.33 1</ambient>
          <diffuse>0.42 0.45 0.49 1</diffuse>
          <specular>0.18 0.18 0.18 1</specular>
        </material>
      </visual>

      <visual name="left_wing_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/left_wing.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.38 0.40 0.43 1</ambient>
          <diffuse>0.58 0.61 0.65 1</diffuse>
          <specular>0.20 0.20 0.20 1</specular>
        </material>
      </visual>

      <visual name="right_wing_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/right_wing.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.38 0.40 0.43 1</ambient>
          <diffuse>0.58 0.61 0.65 1</diffuse>
          <specular>0.20 0.20 0.20 1</specular>
        </material>
      </visual>

      <!--
        Motor görselleri: mesh ham global koordinatlarında bırakılır,
        yeniden kaydırılmaz. Belgelenen "motor merkezi" referansı
        (0.2623, +/-0.3000, 0.1269) m'dir ve mesh'in kendi konumu buna
        karşı çapraz kontrol edilmiştir; mesh bu noktaya ötelenmemiştir.
        Bounding box merkezi ile adlandırılmış merkez arasındaki yaklaşık
        7.3 mm fark, mesh öteleyerek kapatılmamıştır: ham mesh, ölçek 0.001
        ve sıfır ek pose ile çizilir.
      -->
      <visual name="left_motor_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/left_motor.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.14 0.15 0.17 1</ambient>
          <diffuse>0.25 0.27 0.30 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>

      <visual name="right_motor_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/right_motor.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.14 0.15 0.17 1</ambient>
          <diffuse>0.25 0.27 0.30 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>

      <!-- COLLISION STRATEJİSİ: bu dosyada hiçbir yerde yüksek poligonlu
           ham STL mesh collision geometrisi olarak kullanılmaz, yalnızca
           primitifler kullanılır. Her primitif ilgili mesh'in kendi
           bounding box verisinden türetilir ve ölçü belirsizliğinde
           bilinçli olarak BÜYÜK tarafta tutulur, asla küçük tarafta değil.

           Sabit yatay ve düşey kuyruk için ayrı primitif yoktur: bu yapı
           body.stl içindedir ve aşağıdaki kuyruk bandı kutusu o bölgeyi
           tamamen kapsar. İkinci bir primitif collision hacmini
           çiftlerdi.

           PERVANELERDE HİÇ COLLISION YOKTUR: yüksek devirde dönen ince bir
           disk için burada ne zeminle temas ne de kendi kendine çarpışma
           senaryosu var; eklenmesi yalnızca asılsız self collision
           artefaktı riski doğurur. Bu aynı zamanda yalnızca görsele özel
           pervane ölçeğinin bir fizik hesabına sızmasını yapısal olarak
           imkânsız kılar.

           Model seviyesinde self_collide açıkça false'tur: bazı hareketli
           yüzey mesh'leri menteşe hattında ana yapıyla bilinçli olarak
           bitişir veya hafifçe çakışır (örnek: aileron ile kanat oyuğu);
           self collision açık olsaydı orada asılsız temas kuvvetleri
           doğardı. -->

      <!-- Gövde kutusu 1: burun ve kanat kökü bandı. X aralığı
           [-0.027512, 0.526880] m (burun ucu 0.526880 m doğrulanmış;
           -0.027512 m kanat mesh'inin kendi ileri X sınırı).
           Y = +/-0.094649 m, CONFIRMED kanat kökü istasyonu gövde kesiti.
           Z = [0, 0.330480] m, doğrulanmış tam gövde Z sınırı: buruna özel
           bir Z kesiti bulunmadığı için tam aralık bilinçli olarak büyük
           tarafta seçilmiştir, ölçülmüş bir burun kesiti değildir. -->
      <collision name="fuselage_collision_fwd">
        <pose>0.249684 0 0.165240 0 0 0</pose>
        <geometry>
          <box>
            <size>0.554392 0.189298 0.330480</size>
          </box>
        </geometry>
      </collision>

      <!-- Gövde kutusu 2: orta gövde, kanat kökü bandı ile kuyruk bandı
           arasında. X aralığı [-0.472684, -0.027512] m (kanat mesh'inin
           ileri sınırı ile elevator/rudder mesh'inin en arka X sınırı
           arası). Y = +/-0.280000 m bir ASSUMPTION'dır: orta gövde için
           doğrulanmış kesit verisi yok. Doğrulanmış kuyruk bandı yarı
           genişliği (0.280 m, doğrulanmış kanat kökü yarı genişliği
           0.094649 m'den geniş) bilinçli olarak büyük tarafta vekil değer
           olarak kullanılır, daraltılarak ara değer atanmaz. Z yukarıdaki
           tam gövde aralığı. -->
      <collision name="fuselage_collision_mid">
        <pose>-0.250098 0 0.165240 0 0 0</pose>
        <geometry>
          <box>
            <size>0.445172 0.560000 0.330480</size>
          </box>
        </geometry>
      </collision>

      <!-- Gövde kutusu 3: kuyruk bandı. X aralığı
           [-0.526880, -0.472684] m (kuyruk ucundan elevator/rudder
           mesh'inin ileri X sınırına). Y = +/-0.280000 m, CONFIRMED kuyruk
           istasyonu gövde kesiti. Bu kutu aynı zamanda sabit yatay/düşey
           kuyruk yapısının collision hacmidir: Y ve Z zarfı hem elevator
           yarı açıklığını (240 mm) hem rudder yüksekliğini (299.75 mm)
           aşar. Z tam gövde aralığı, CONFIRMED: gövdenin global maksimum
           Z'si bu X bandında oluşur. -->
      <collision name="fuselage_collision_tail">
        <pose>-0.499782 0 0.165240 0 0 0</pose>
        <geometry>
          <box>
            <size>0.054196 0.560000 0.330480</size>
          </box>
        </geometry>
      </collision>

      <!-- Sol/sağ kanat collision: kanat başına tek kutu, her kanadın
           kendi tam mesh bounding box'ı. Bilinçli olarak kaba bir
           yaklaşım: sabit veterli kutu, gerçek sivrilen planforma göre dış
           kanatta büyük kalır (kök veteri 0.260 m, uç veteri 0.051 m).
           Sivrilmeyi izleyen çok parçalı bir uydurma değil, güvenli tarafta
           bir basitleştirmedir. -->
      <collision name="left_wing_collision">
        <pose>0.105743 0.566014 0.127019 0 0 0</pose>
        <geometry>
          <box>
            <size>0.266510 0.972027 0.046956</size>
          </box>
        </geometry>
      </collision>

      <collision name="right_wing_collision">
        <pose>0.105743 -0.566014 0.127019 0 0 0</pose>
        <geometry>
          <box>
            <size>0.266510 0.972027 0.046956</size>
          </box>
        </geometry>
      </collision>

      <!-- Motor collision: nasel başına küçük bir kutu, her motorun kendi
           tam mesh bounding box'ı. Collision geometrisi SDF'de kütlesizdir;
           kütle yalnızca <inertial> içinde tanımlanır, motor kütlesi
           base_link'in kütlesi içinde kalır. -->
      <collision name="left_motor_collision">
        <pose>0.269577 0.299975 0.126974 0 0 0</pose>
        <geometry>
          <box>
            <size>0.066484 0.038225 0.038237</size>
          </box>
        </geometry>
      </collision>

      <collision name="right_motor_collision">
        <pose>0.269577 -0.299975 0.126974 0 0 0</pose>
        <geometry>
          <box>
            <size>0.066484 0.038225 0.038237</size>
          </box>
        </geometry>
      </collision>

      <!-- SENSÖRLER. Native gz-sim sensörleri (IMU, GPS, barometre). Bu
           <sensor> elemanlarını işleyen sistem eklentileri WORLD
           seviyesinde yüklenir, burada değil.

           MONTAJ KONUMU (aşağıdaki özel pitot ve manyetometre eklentileri
           dâhil tüm sensörler): Gazebo/CAD CG'si (0.168309, 0, 0.100000) m
           ile aynı nokta, yani bu linkin <inertial><pose> değeri için de
           yetkili olan nokta. Bu keyfi bir sayı değil, belgelenmiş bir
           tercihtir: gerçek aviyonik montaj konumu DATA_REQUIRED (CAD veya
           kılavuz verisi yok), bu yüzden kaynaksız bir ofset uydurmak
           yerine gövde üzerindeki tek yetkili nokta kullanılır. Böylece
           hiçbir gerçek veriyle doğrulanamayacak bir kaldıraç kolu hız
           etkisi (V_nokta = V_cg + omega x r) da modele girmemiş olur.
           Etiket: SIMULATION_ASSUMPTION.

           GÜRÜLTÜ: aşağıdaki tüm sensörlerde kapalı, yani deterministik
           sıfır gürültü modu; hiçbirinde <noise> alt elemanı yok. IMU'nun
           altında ileride kullanılmak üzere V1_PROVISIONAL bir gürültü
           bloğu yorum içinde örnek olarak bırakılmıştır.

           GÜNCELLEME HIZLARI: hiçbiri gövdeye veya otopilota özel bir
           datasheet değeri değil, kaynak veride böyle bir değer yok. Her
           biri mertebe olarak makul, belgelenmiş V1_PROVISIONAL
           seçimlerdir. -->

      <!-- IMU: orientation_reference_frame=CUSTOM, parent_frame="world",
           custom_rpy="0 0 0". Yani "ENU" lokalizasyon dizesi değil, boot'a
           göreli CUSTOM varsayılanı da değil. Bu bilinçli bir netlik
           tercihidir, "ENU" bozuk bulunduğu için değil: imu.sdf
           şartnamesi parent_frame="world" ile custom_rpy="0 0 0" ikilisini
           ("IMU Gazebo world çerçevesinde raporlar") açık ve belirsizlik
           içermeyen alternatif olarak belgeler; bu seçim ENU dizesinin
           SphericalCoordinates üzerinden dolaylı çözümüne bağımlı olmaz.

           Raporlanan oryantasyon kuaterniyonu, gövde FLU'sunun Gazebo world
           (ENU) çerçevesine göre dönüşüdür ve FRD/NED'e çevirmek için
           plugins/sensors/Frames.hh içindeki AttitudeFluEnuToFrdNed()
           fonksiyonunun doğrudan girdisidir. Açısal hız ile doğrusal ivme
           (özgül kuvvet) sensörün kendi çerçevesinde raporlanır; bu
           sensörün base_link'e göre dönüşü sıfır olduğundan o çerçeve gövde
           FLU'dur. -->
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <topic>/model/falcon_v2/sensors/imu</topic>
        <pose>0.168309 0 0.100000 0 0 0</pose>
        <imu>
          <orientation_reference_frame>
            <localization>CUSTOM</localization>
            <custom_rpy parent_frame="world">0 0 0</custom_rpy>
          </orientation_reference_frame>
        </imu>
        <!-- V1_PROVISIONAL_SENSOR_NOISE örneği (KAPALI. Yorumdan
             çıkarılmadıkça ve stddev değerleri kaynaklanmadıkça
             uygulanmaz):
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></z>
          </linear_acceleration>
        </imu>
        -->
      </sensor>

      <!-- ARDUPILOT KÖPRÜSÜ İÇİN IMU RÖLE SENSÖRÜ (ek sensör; yukarıdaki
           imu_sensor değiştirilmemiştir).

           NEDEN İKİNCİ BİR IMU ÖRNEĞİ: ardupilot_gazebo'nun
           ArduPilotPlugin'i bir sensörün kendi SDF <topic> değerini
           okumaz. Abone olacağı topic'i bağımsız olarak
           gz::sim::scopedName(imuEntity, ecm) + "/imu" biçiminde hesaplar,
           yani gz-sim'in otomatik ürettiği varsayılan sensör topic'ini:
           "/world/<world>/model/falcon_v2/link/base_link/sensor/<ad>/imu".
           Yukarıdaki imu_sensor ise özel bir <topic> tanımlar
           (/model/falcon_v2/sensors/imu) ve açık <topic> verilmiş bir
           gz-sensors sensörü YALNIZCA o özel topic'te yayınlar, ek olarak
           varsayılan topic'te yayınlamaz. Dolayısıyla eklentinin
           hesapladığı topic hiç eşleşmez, imuMsgValid hiç true olmaz ve
           CreateStateJSON() sessizce hiç paket kurmaz: köprü yanlış sayı
           göndermek yerine ArduPlane'e hiç FDM verisi göndermez.

           Bu ikinci sensör örneği yalnızca ArduPilot köprüsü için ve
           bilinçli olarak <topic> ELEMANI OLMADAN eklenmiştir; böylece
           gz-sim'in Sensors sistemi ona ArduPilotPlugin'in beklediği
           varsayılan topic'i atar. Montaj noktası,
           orientation_reference_frame, güncelleme hızı ve sıfır gürültü
           modu yukarıdaki imu_sensor ile aynıdır. Bu ikinci bir fiziksel
           sensör değil, taşıma katmanında bir kopyadır. TEK istisna <pose>
           DÖNÜŞ bileşenidir; hemen aşağıdaki FLU/FRD yorumuna bakın. -->

      <!-- FLU'DAN FRD'YE GYRO/İVME DÜZELTMESİ.

           ArduPilotPlugin::CreateStateJSON(), bu sensörün ham
           imuMsg.angular_velocity() ve linear_acceleration() değerlerini
           JSON'un "gyro"/"accel_body" alanlarına HİÇ DÖNÜŞ UYGULAMADAN
           yazar: FLU'dan FRD'ye gövde dönüşümü olan
           modelXYZToAirplaneXForwardZDown bu eklenti sürümünde yalnızca
           konum, hız ve kuaterniyon için kurulup kullanılır, IMU mesajı
           için asla. Sıfır dönüşlü bir <pose> ile roll ekseni gyro'su doğru
           okunur (FLU +X = FRD +X, çevirme gerekmez) ama pitch ve yaw'da
           hiç işaret değişimi olmaz; ham FLU verisi ArduPlane'in FRD
           varsayan AHRS/EKF'sine dönüştürülmeden ulaşır. Bu, ısrarlı bir
           "AHRS: DCM Roll/Pitch inconsistent" prearm hatasının kök
           nedenidir.

           DÜZELTME: ArduPilotPlugin IMU mesajını hiç döndürmediği için
           dönüşüm BU sensörün kendi montaj DÖNÜŞÜNE gömülür (konum ofseti
           değişmez): gövde X ekseni etrafında 180 derece dönüş. Bu değer
           sayısal olarak modelXYZToAirplaneXForwardZDown'ın derlenmiş
           varsayılanı Pose3d(0,0,0,GZ_PI,0,0) ile ve
           plugins/sensors/Frames.hh içindeki kQFluToFrdRot ile birebir
           aynıdır.

           BU NEDEN GERÇEKTEN SENSÖR ÇIKTISINI DEĞİŞTİRİR (kozmetik bir
           montaj etiketi değildir):
           - gz-sim Physics.cc: ebeveyn linkine göre <pose> ofseti olan
             sensör gibi link dışı bir varlık için raporlanan
             components::AngularVelocity/LinearAcceleration değerleri
             entityWorldPose.Rot().RotateVectorReverse(entityWorldVec)
             olarak hesaplanır. World çerçevesindeki vektör, varlığın
             tam olarak kurulmuş world oryantasyonuna döndürülür ve bu
             oryantasyon ebeveyn linkin dönüşü ile bu sensörün yerel <pose>
             dönüşünün bileşkesidir. Buradaki bir dönüş bu nedenle sensörün
             raporladığı ham gyro/ivmeyi, fiziksel olarak yeniden
             yönlendirilmiş bir çip gibi döndürür.
           - gz-sensors ImuSensor::Update(), ivmeölçerin özgül kuvvet
             katkısı için yer çekimini aynı bileşke yerel çerçeveye
             döndürür; böylece accel_body da yer çekimi telafisi dâhil aynı
             dönüşü tutarlı biçimde alır.
           - Cebir kontrolü: X etrafında saf 180 derece dönüş R kendi
             tersidir (R = diag(1,-1,-1)); FLU link çerçevesindeki bir
             vektöre RotateVectorReverse uygulandığında (x,-y,-z) verir, bu
             da tam olarak FluFrdSwap()'tir. Saf gövde +X (roll) hızı
             değişmez, hâlihazırda doğru olan roll sonucuyla uyumludur; saf
             +Y (pitch) veya +Z (yaw) hızları işaret değiştirir, gereken
             FLU/FRD dönüşümüyle uyumludur.
           - Yan etki olarak bu sensörün kendi oryantasyon kuaterniyon
             çıktısı da değişir, ama burada önemsizdir: CreateStateJSON()
             onu hiç okumaz. ArduPilot'un kuaterniyonu, konumu ve hızı
             wldAToBdyA dönüşümlü ayrı bir pose hattından gelir ve bu
             dönüşten etkilenmez.

           Kapsam: bu yalnızca imu_sensor_ardupilot'un <pose> dönüşünü
           etkiler. Yukarıdaki imu_sensor'a dokunulmaz; onun gereken
           FLU/FRD dönüşümü yazılım tarafında
           Frames.hh::FluFrdSwap() ile yapılır. -->
      <sensor name="imu_sensor_ardupilot" type="imu">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <pose degrees="true">0.168309 0 0.100000 180 0 0</pose>
        <imu>
          <orientation_reference_frame>
            <localization>CUSTOM</localization>
            <custom_rpy parent_frame="world">0 0 0</custom_rpy>
          </orientation_reference_frame>
        </imu>
      </sensor>

      <!-- GPS (navsat): lat/lon/alt (WGS84, world'ün spherical_coordinates
           bloğuna göre) ve velocity_east/north/up değerlerini açıkça
           raporlar (gz.msgs.NavSat, navsat.proto üzerinden CONFIRMED),
           yani yapısı gereği ENU, belirsizlik yok. Konum referans orijini
           world dosyasının <spherical_coordinates> bloğudur
           (lat=0, lon=0, elevation=0): PLACEHOLDER_ORIGIN. Uçağın gerçek
           uçuş testi konumu DATA_REQUIRED. -->
      <sensor name="gps_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>5</update_rate>
        <topic>/model/falcon_v2/sensors/gps</topic>
        <pose>0.168309 0 0.100000 0 0 0</pose>
      </sensor>

      <!-- Barometre (air_pressure): gz.msgs.FluidPressure (Pa) yayınlar.
           reference_altitude=0, world dosyasındaki spherical_coordinates
           elevation=0 yer tutucu orijiniyle tutarlıdır; bağımsız olarak
           seçilmiş ikinci bir sayı değildir. Basınçtan irtifaya dönüşümü
           ArduPilot'un kendi barometre arka ucu yapar, burada yapılmaz. -->
      <sensor name="baro_sensor" type="air_pressure">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <topic>/model/falcon_v2/sensors/baro</topic>
        <pose>0.168309 0 0.100000 0 0 0</pose>
        <air_pressure>
          <reference_altitude>0</reference_altitude>
        </air_pressure>
      </sensor>

      <!-- Manyetometre burada bilinçli olarak native
           <sensor type="magnetometer"> olarak TANIMLANMAMIŞTIR. Bu Gazebo
           Sim Harmonic kurulumunda native sensör ile world seviyesindeki
           gz-sim-magnetometer-system ikilisi, world'de bildirilen
           <magnetic_field> değerindeki 100 katlık değişime hiç tepki
           vermeyen, sabit yaklaşık 0.32 büyüklüklü bir field_tesla çıktısı
           yayınlar. Bu, modeldeki bir işaret, çerçeve veya yapılandırma
           hatası değil, kurulu kütüphanelerde tekrarlanabilir bir kusurdur.
           Kanıt zinciri plugins/sensors/MagnetometerSystem.hh başlık
           yorumunda.

           Yerine, aşağıda FalconV2Pitot'un yanında tanımlı özel
           FalconV2Magnetometer eklentisi kullanılır: AYNI topic'te
           (/model/falcon_v2/sensors/mag, gz.msgs.Magnetometer, field_tesla,
           gövde FLU çerçevesi, base_link'e göre sıfır dönüş) yayınlar,
           böylece hiçbir tüketicinin değişmesi gerekmez ve bildirilen
           Dünya alanı değerini gerçekten kullanır. -->
    </link>

    <!-- SOL AİLERON: hareketli link. Link orijini, uydurulan menteşe
         hattının kök noktasına yerleştirilir; mesh görseli ve collision'ı
         aynı noktanın negatifi kadar ötelenir, böylece çizilen mesh görsel
         olarak kaymaz (link orijini + mesh ofseti, mesh'in kendi global
         konumunu sayısal olarak yeniden üretir).

         MENTEŞE EKSENİ UYDURMA YÖNTEMİ (aileron, elevator, rudder için
         aynı): eksen, ilgili STL dosyasının kendi köşe verisinin doğrudan
         yeniden okunmasıyla uydurulur (salt okuma; hiçbir mesh dosyası
         değiştirilmez). Belgelenmiş her %veter istasyonunda +/-3 mm'lik dar
         bantlar alınır ve uç kaynaklı aykırı değerler deterministik bir
         kuralla dışlanır. Yüzey başına uydurma artıkları ilgili linkin
         yorumunda verilir.

         Link orijini (m):     (0.032943, 0.313950, 0.110356)
         Mesh görsel ofseti:  (-0.032943, -0.313950, -0.110356)
         Joint ekseni (birim vektör, uydurulan menteşe hattı doğrultusu,
         dY=+1 yönünde):       (0.000994, 0.999899, 0.014146)
         Hareketli açıklık (XFLR5'te etkin): y = 0.313950 ile 0.784875 m
         Uydurma artığı, BİRİNCİL/X (mm): RMS 0.0123, maks 0.0204
         (4 istasyon). İKİNCİL/Z (mm): RMS 0.0020, maks 0.0028
         (3 istasyon; y=784.875 mm yalnızca Z uydurmasından uç yakınlığı
         artefaktı olarak çıkarıldı, X değeri etkilenmedi ve kullanılmaya
         devam ediyor).
         Menteşe %veter kanıtı: yaklaşık %69.75 ile %72.14 bandı.
         Kütle: TEMPORARY_NUMERICAL_MASS = 0.001 kg. Bu parçalar için
         kaynak veride bileşen seviyesinde kütle yok; gövde yapısal kütlesi
         ayrıştırılmamış bir kalandır. 0.001 kg fiziksel bir iddia değil,
         Gazebo'nun hareketli bir linki çözebilmesi için gereken, neredeyse
         kütlesiz sayısal alt sınırdır.
         Atalet: bu linkin kendi mesh bounding box ölçüsüyle
         (61.119 x 479.366 x 20.953 mm) ince kutu yaklaşımı, linkin kendi
         yerel kütle merkezi tahmini (bounding box merkezi) etrafında.
         Neredeyse kütlesiz bir yer tutucu link için geometrik bir
         yaklaşımdır, fiziksel doğruluk iddiası değildir. -->
    <link name="left_aileron">
      <pose>0.032943 0.313950 0.110356 0 0 0</pose>

      <inertial>
        <pose>-0.025962 0.236107 0.007807 0 0 0</pose>
        <mass>0.001</mass>
        <inertia>
          <ixx>1.9186e-05</ixx>
          <iyy>3.4788e-07</iyy>
          <izz>1.9461e-05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="left_aileron_visual">
        <pose>-0.032943 -0.313950 -0.110356 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/left_aileron.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.65 0.16 0.015 1</ambient>
          <diffuse>1.0 0.32 0.025 1</diffuse>
          <specular>0.25 0.20 0.12 1</specular>
        </material>
      </visual>

      <collision name="left_aileron_collision">
        <pose>-0.025962 0.236107 0.007807 0 0 0</pose>
